<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TATU Kutubxona | Admin — Bronlar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style> body { font-family: 'Inter', sans-serif; background: #f1f5f9; } </style>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& reservations = @@.get<RowList>("reservations");
    auto& csrf         = @@.get<std::string>("csrf_token");
    auto& flashMsg     = @@.get<std::string>("flash_msg");
    auto& flashType    = @@.get<std::string>("flash_type");
%>

<nav class="bg-slate-900 text-white sticky top-0 z-50 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-7 h-7 bg-blue-500 rounded-lg flex items-center justify-center font-black text-xs">T</div>
            <span class="font-bold text-sm">TATU Admin</span>
            <span class="text-slate-500 text-xs">|</span>
            <span class="text-slate-300 text-xs font-medium">Bronlar</span>
        </div>
        <div class="flex items-center gap-1 text-xs">
            <a href="/admin/dashboard" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Panel</a>
            <a href="/admin/readers" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">O'quvchilar</a>
            <a href="/admin/books" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Kitoblar</a>
            <a href="/admin/bronlar" class="px-3 py-1.5 rounded-lg bg-slate-700 text-white transition">Bronlar</a>
            <a href="/admin/berishlar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Berishlar</a>
            <a href="/admin/kartalar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Kartalar</a>
            <a href="/admin/analitika" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition"><i class="fas fa-chart-bar mr-1"></i>Analitika</a>
            <a href="/admin/chiqish" class="ml-2 px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white transition">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </div>
    </div>
</nav>

<%c++ if (!flashMsg.empty()) { %>
<div class="max-w-7xl mx-auto px-4 pt-4">
    <div class="px-4 py-3 rounded-xl text-sm font-medium flex items-center gap-2
        <%c++ if (flashType == "success") { %>bg-green-50 border border-green-200 text-green-700<%c++ } else { %>bg-red-50 border border-red-200 text-red-700<%c++ } %>">
        <i class="fas <%c++ if (flashType == "success") { %>fa-check-circle<%c++ } else { %>fa-exclamation-circle<%c++ } %>"></i>
        <%c++ AdminReservations_tmp_stream << flashMsg; %>
    </div>
</div>
<%c++ } %>

<main class="max-w-7xl mx-auto px-4 py-8 flex-grow w-full">
    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-xl font-bold text-slate-800">
                <i class="fas fa-bookmark text-blue-600 mr-2"></i>Barcha bronlar
            </h1>
            <p class="text-sm text-slate-400 mt-0.5">Jami <strong><%c++ AdminReservations_tmp_stream << reservations.size(); %></strong> ta bron</p>
        </div>
        <a href="/admin/berishlar" class="text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg transition">
            <i class="fas fa-plus mr-1.5"></i>Kitob berish
        </a>
    </div>

    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
        <%c++ if (reservations.empty()) { %>
        <div class="text-center py-16">
            <i class="fas fa-bookmark text-5xl text-slate-200 mb-4 block"></i>
            <p class="text-slate-400 font-medium">Hozircha hech qanday bron yo'q.</p>
        </div>
        <%c++ } else { %>
        <!-- Qidiruv -->
        <div class="p-4 border-b border-slate-100">
            <input type="text" id="searchInput" placeholder="O'quvchi yoki kitob nomi bo'yicha qidirish..."
                   oninput="filterTable()"
                   class="w-full max-w-sm text-sm px-4 py-2 rounded-lg border border-slate-200 focus:border-blue-400 outline-none bg-slate-50">
        </div>
        <div class="overflow-x-auto">
            <table class="w-full text-sm" id="resTable">
                <thead class="bg-slate-50 border-b border-slate-100">
                    <tr>
                        <th class="text-left px-4 py-3 text-xs font-bold text-slate-500 uppercase tracking-wide">#</th>
                        <th class="text-left px-4 py-3 text-xs font-bold text-slate-500 uppercase tracking-wide">O'quvchi</th>
                        <th class="text-left px-4 py-3 text-xs font-bold text-slate-500 uppercase tracking-wide">Kitob</th>
                        <th class="text-left px-4 py-3 text-xs font-bold text-slate-500 uppercase tracking-wide">Bron sanasi</th>
                        <th class="text-right px-4 py-3 text-xs font-bold text-slate-500 uppercase tracking-wide">Amal</th>
                    </tr>
                </thead>
                <tbody id="resBody">
                <%c++ int idx = 1;
                for (const auto& r : reservations) { %>
                    <tr class="border-b border-slate-50 hover:bg-slate-50 transition res-row">
                        <td class="px-4 py-3 text-slate-400 font-mono text-xs"><%c++ AdminReservations_tmp_stream << idx++; %></td>
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-2">
                                <div class="w-7 h-7 rounded-full bg-blue-100 flex items-center justify-center text-blue-700 font-bold text-xs flex-shrink-0">
                                    <%c++ std::string rn = getOr(r, "reader_name");
                                          AdminReservations_tmp_stream << (rn.empty() ? "?" : std::string(1, rn[0])); %>
                                </div>
                                <span class="font-medium text-slate-700"><%c++ AdminReservations_tmp_stream << getOr(r, "reader_name", "—"); %></span>
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            <a href="/kitob/<%c++ AdminReservations_tmp_stream << getOr(r, "book"); %>"
                               class="text-blue-600 hover:underline font-medium">
                                <%c++ AdminReservations_tmp_stream << getOr(r, "book_title", "—"); %>
                            </a>
                        </td>
                        <td class="px-4 py-3 text-slate-500 text-xs">
                            <%c++ std::string dt = getOr(r, "reserved_at");
                                  AdminReservations_tmp_stream << (dt.size() > 10 ? dt.substr(0,10) : dt); %>
                        </td>
                        <td class="px-4 py-3 text-right">
                            <form action="/admin/bronlar/<%c++ AdminReservations_tmp_stream << getOr(r, "id"); %>/bekor" method="POST"
                                  onsubmit="return confirm('Bu bronni bekor qilmoqchimisiz?')">
                                <input type="hidden" name="csrf_token" value="<%c++ AdminReservations_tmp_stream << csrf; %>">
                                <button type="submit"
                                        class="text-xs font-bold text-red-600 hover:bg-red-50 border border-red-200 px-3 py-1.5 rounded-lg transition">
                                    <i class="fas fa-times mr-1"></i>Bekor
                                </button>
                            </form>
                        </td>
                    </tr>
                <%c++ } %>
                </tbody>
            </table>
        </div>
        <%c++ } %>
    </div>
</main>

<script>
function filterTable() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('.res-row').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}
</script>
</body>
</html>
