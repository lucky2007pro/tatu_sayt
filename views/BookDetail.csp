<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <%c++ BookDetail_tmp_stream << PREMIUM_HEAD; %>
    <title>TATU Kutubxona | Kitob</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <style>
        .star-label { cursor:pointer; font-size:1.8rem; color:#d1d5db; transition:color .15s; }
        .star-label:hover, .star-label.selected { color:#f59e0b; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& book      = @@.get<Row>("book");
    auto& ratings   = @@.get<RowList>("ratings");
    auto  loggedIn  = @@.get<bool>("is_logged_in");
    auto  approved  = @@.get<bool>("reader_approved");
    auto& name      = @@.get<std::string>("reader_name");
    auto& csrf      = @@.get<std::string>("csrf_token");
    auto& flashMsg  = @@.get<std::string>("flash_msg");
    auto& flashType = @@.get<std::string>("flash_type");
    auto& similar   = @@.get<RowList>("similar");
    auto bookId     = getOr(book, "id");
    auto bookName   = getOr(book, "title", "Kitob");
    std::string bookStatus = getOr(book, "availability_status", "available");
    bool isAvail    = (bookStatus == "available");
    bool isIssued   = (bookStatus == "issued");
    bool isReserved = (bookStatus == "reserved");
    bool canReserve = isAvail;
%>

<!-- NAVBAR -->
<nav class="navbar-premium sticky top-0 z-50">
    <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5">
            <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center text-white font-black text-sm shadow-md">T</div>
            <span class="font-extrabold text-slate-800 tracking-tight">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <%c++ if (loggedIn) { %>
            <a href="/kabinet" class="text-xs font-semibold text-slate-600 border border-slate-200 px-3 py-2 rounded-lg hover:border-blue-400 hover:text-blue-600 transition"><i class="fas fa-user mr-1"></i><%c++ BookDetail_tmp_stream << name; %></a>
            <a href="/chiqish" class="text-xs text-red-500 hover:text-red-700 px-2 py-2 rounded-lg hover:bg-red-50/60 transition font-semibold">Chiqish</a>
            <%c++ } else { %>
            <a href="/kirish" class="btn-prem btn-prem-primary text-xs py-2 px-4">Kirish</a>
            <%c++ } %>
        </div>
    </div>
</nav>

<!-- Flash -->
<%c++ if (!flashMsg.empty()) { %>
<div class="max-w-4xl mx-auto px-4 pt-4">
    <div class="toast-premium <%c++ if (flashType == "success") { %>toast-success<%c++ } else { %>toast-error<%c++ } %>">
        <%c++ if (flashType == "success") { %>✅<%c++ } else { %>⚠️<%c++ } %>
        <%c++ BookDetail_tmp_stream << flashMsg; %>
    </div>
</div>
<%c++ } %>

<main class="max-w-4xl mx-auto px-4 py-8 flex-1 page-transition">
    <a href="/" class="inline-flex items-center gap-1.5 text-sm text-slate-400 hover:text-blue-600 mb-6 transition font-medium">
        <i class="fas fa-arrow-left text-xs"></i> Kitoblarga qaytish
    </a>

    <div class="card-premium overflow-hidden fade-in-up">
        <div class="flex flex-col md:flex-row gap-0">
            <!-- Muqova -->
            <div class="md:w-56 flex-shrink-0 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center min-h-64 relative book-cover-shimmer">
                <%c++ auto cover = getOr(book, "cover_image"); if (!cover.empty()) { %>
                <img src="<%c++ BookDetail_tmp_stream << cover; %>" class="w-full h-full object-cover" alt="">
                <%c++ } else { %>
                <i class="fas fa-book text-slate-300 text-6xl"></i>
                <%c++ } %>
                <div class="absolute top-3 right-3">
                    <span class="pill-premium <%c++ if (isAvail) { %>pill-emerald<%c++ } else if (isIssued) { %>pill-amber<%c++ } else { %>pill-rose<%c++ } %>">
                        <%c++ if (isAvail) { %>✅ Mavjud<%c++ } else if (isIssued) { %>📤 Berilgan<%c++ } else { %>🔖 Bron qilingan<%c++ } %>
                    </span>
                </div>
            </div>

            <!-- Ma'lumotlar -->
            <div class="flex-1 p-6 md:p-8">
                <h1 class="text-2xl font-extrabold text-slate-800 mb-1 tracking-tight"><%c++ BookDetail_tmp_stream << bookName; %></h1>
                <%c++ auto author = getOr(book, "author_name"); if (!author.empty()) { %>
                <p class="text-slate-500 text-sm mb-4"><i class="fas fa-user-edit mr-1"></i><%c++ BookDetail_tmp_stream << author; %></p>
                <%c++ } %>

                <div class="flex flex-wrap gap-2 mb-5">
                    <%c++ auto lib = getOr(book, "library_name"); if (!lib.empty()) { %>
                    <span class="pill-premium pill-slate"><i class="fas fa-building mr-1"></i><%c++ BookDetail_tmp_stream << lib; %></span>
                    <%c++ } %>
                    <%c++ auto sec = getOr(book, "section_name"); if (!sec.empty()) { %>
                    <span class="pill-premium pill-blue"><i class="fas fa-bookmark mr-1"></i><%c++ BookDetail_tmp_stream << sec; %></span>
                    <%c++ } %>
                    <%c++ auto rating = getOr(book, "average_rating"); if (!rating.empty() && rating != "0" && rating != "0.0") { %>
                    <span class="pill-premium pill-amber">★ <%c++ BookDetail_tmp_stream << rating; %> / 5</span>
                    <%c++ } %>
                    <%c++ auto views = getOr(book, "view_count"); if (!views.empty() && views != "0") { %>
                    <span class="pill-premium pill-slate"><i class="fas fa-eye mr-1"></i><%c++ BookDetail_tmp_stream << views; %></span>
                    <%c++ } %>
                    <%c++ auto ebook = getOr(book, "ebook_file"); if (!ebook.empty() && ebook != "null") { %>
                    <a href="<%c++ BookDetail_tmp_stream << ebook; %>" target="_blank" class="pill-premium pill-purple hover:opacity-80 transition">
                        <i class="fas fa-tablet-alt mr-1"></i>E-kitob — yuklab olish
                    </a>
                    <%c++ } %>
                </div>

                <%c++ auto descr = getOr(book, "description"); if (!descr.empty()) { %>
                <div class="mb-6">
                    <h3 class="text-sm font-bold text-slate-700 mb-2">Tavsif</h3>
                    <p class="text-sm text-slate-500 leading-relaxed"><%c++ BookDetail_tmp_stream << descr; %></p>
                </div>
                <%c++ } %>

                <div class="flex flex-wrap gap-3 pt-4 border-t border-slate-100">
                    <%c++ if (loggedIn) { %>
                        <%c++ if (canReserve) { %>
                            <%c++ if (approved) { %>
                            <form method="POST" action="/kitob/<%c++ BookDetail_tmp_stream << bookId; %>/band">
                                <input type="hidden" name="csrf_token" value="<%c++ BookDetail_tmp_stream << csrf; %>">
                                <button type="submit" class="btn-prem btn-prem-success"><i class="fas fa-calendar-check mr-1"></i>Band qilish</button>
                            </form>
                            <%c++ } else { %>
                            <button disabled class="btn-prem btn-prem-ghost opacity-50 cursor-not-allowed"><i class="fas fa-clock mr-1"></i>Tasdiqlanmagan hisob</button>
                            <%c++ } %>
                        <%c++ } else if (isIssued) { %>
                        <button disabled class="btn-prem btn-prem-ghost opacity-50 cursor-not-allowed"><i class="fas fa-book-open mr-1"></i>Kitob hozir berilgan</button>
                        <%c++ } else { %>
                        <button disabled class="btn-prem btn-prem-ghost opacity-50 cursor-not-allowed"><i class="fas fa-bookmark mr-1"></i>Bron qilingan</button>
                        <%c++ } %>
                        <button onclick="document.getElementById('rate-modal').style.display='flex'" class="btn-prem btn-prem-accent"><i class="fas fa-star mr-1"></i>Baholash</button>
                    <%c++ } else { %>
                    <a href="/kirish" class="btn-prem btn-prem-primary"><i class="fas fa-sign-in-alt mr-1"></i>Band qilish uchun kiring</a>
                    <%c++ } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Kutubxona joylashuvi -->
    <%c++ auto bLat = getOr(book, "library_latitude"); auto bLon = getOr(book, "library_longitude"); auto bLib = getOr(book, "library_name");
          bool hasGeo = !bLat.empty() && bLat != "0" && bLat != "0.0" && bLat != "null" && !bLon.empty() && bLon != "0" && bLon != "0.0" && bLon != "null";
          if (hasGeo) { %>
    <div class="mt-8 card-premium overflow-hidden fade-in-up-delay-1">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between flex-wrap gap-2">
            <div class="section-heading-premium text-base">
                <span class="icon-wrap" style="background:linear-gradient(135deg,#dc2626,#f87171);width:32px;height:32px"><i class="fas fa-map-marker-alt text-xs"></i></span>
                Kutubxona joylashuvi
                <%c++ if (!bLib.empty()) { %><span class="text-sm font-normal text-slate-500 ml-1">— <%c++ BookDetail_tmp_stream << bLib; %></span><%c++ } %>
            </div>
            <div class="flex items-center gap-2 flex-wrap">
                <span id="distance-info" class="hidden pill-premium pill-blue"><i class="fas fa-route mr-1"></i><span id="distance-value"></span> km</span>
                <button type="button" id="directions-yandex" class="btn-prem btn-prem-ghost text-xs py-1.5 px-3 border border-red-200 text-red-600"><i class="fas fa-route mr-1"></i>Yandex</button>
                <button type="button" id="directions-google" class="btn-prem btn-prem-ghost text-xs py-1.5 px-3 border border-blue-200 text-blue-600"><i class="fab fa-google mr-1"></i>Google</button>
            </div>
        </div>
        <div class="map-premium" style="border-radius:0"><div id="lib-map" style="height:320px;width:100%;z-index:0;"></div></div>
        <p class="text-xs text-slate-400 px-6 py-2 border-t border-slate-50"><i class="fas fa-info-circle text-blue-400 mr-1"></i>Joylashuvingizni ulashsangiz, masofa va yo'nalish ko'rsatiladi.</p>
    </div>
    <script>
    (function() {
        const lat = parseFloat("<%c++ BookDetail_tmp_stream << bLat; %>");
        const lon = parseFloat("<%c++ BookDetail_tmp_stream << bLon; %>");
        const libName = "<%c++ BookDetail_tmp_stream << bLib; %>";
        if (!isFinite(lat) || !isFinite(lon)) return;
        const map = L.map('lib-map').setView([lat, lon], 16);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', { attribution: '&copy; OpenStreetMap', maxZoom: 19 }).addTo(map);
        const libIcon = L.divIcon({ className: '', html: '<div style="background:linear-gradient(135deg,#dc2626,#ef4444);color:#fff;width:36px;height:36px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(220,38,38,.35);border:2px solid #fff"><i class="fas fa-book" style="transform:rotate(45deg);font-size:14px"></i></div>', iconSize: [36, 36], iconAnchor: [18, 36] });
        const marker = L.marker([lat, lon], { icon: libIcon }).addTo(map);
        if (libName) marker.bindPopup('<b>' + libName + '</b>').openPopup();
        let userPos = null;
        try { const raw = localStorage.getItem('tatu_user_geo'); if (raw) { const c = JSON.parse(raw); if (c.lat && c.lon) userPos = { lat: parseFloat(c.lat), lon: parseFloat(c.lon) }; } } catch {}
        if (userPos) {
            const userIcon = L.divIcon({ className: '', html: '<div style="background:#2563eb;color:#fff;width:18px;height:18px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 3px rgba(37,99,235,.35)"></div>', iconSize: [24, 24], iconAnchor: [12, 12] });
            L.marker([userPos.lat, userPos.lon], { icon: userIcon }).addTo(map).bindPopup('Sizning joylashuvingiz');
            L.polyline([[userPos.lat, userPos.lon], [lat, lon]], { color: '#2563eb', weight: 3, opacity: 0.6, dashArray: '8, 8' }).addTo(map);
            map.fitBounds([[userPos.lat, userPos.lon], [lat, lon]], { padding: [40, 40] });
            const R = 6371, toRad = d => d * Math.PI / 180, dLat = toRad(lat - userPos.lat), dLon = toRad(lon - userPos.lon);
            const a = Math.sin(dLat/2)**2 + Math.cos(toRad(userPos.lat))*Math.cos(toRad(lat))*Math.sin(dLon/2)**2;
            const dist = 2 * R * Math.asin(Math.sqrt(a));
            document.getElementById('distance-info').classList.remove('hidden');
            document.getElementById('distance-value').textContent = dist.toFixed(2);
        }
        document.getElementById('directions-yandex').addEventListener('click', () => { window.open(userPos ? `https://yandex.com/maps/?rtext=${userPos.lat},${userPos.lon}~${lat},${lon}&rtt=auto` : `https://yandex.com/maps/?ll=${lon},${lat}&z=16&pt=${lon},${lat},pm2rdm`, '_blank', 'noopener'); });
        document.getElementById('directions-google').addEventListener('click', () => { window.open(userPos ? `https://www.google.com/maps/dir/${userPos.lat},${userPos.lon}/${lat},${lon}` : `https://www.google.com/maps/search/?api=1&query=${lat},${lon}`, '_blank', 'noopener'); });
    })();
    </script>
    <%c++ } %>

    <!-- Izohlar -->
    <div class="mt-8 card-premium overflow-hidden fade-in-up-delay-2">
        <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
            <div class="section-heading-premium text-base">
                <span class="icon-wrap" style="width:32px;height:32px"><i class="fas fa-comments text-xs"></i></span>
                Foydalanuvchilar fikrlari
                <span class="pill-premium pill-blue ml-2"><%c++ BookDetail_tmp_stream << ratings.size(); %></span>
            </div>
        </div>
        <%c++ if (ratings.empty()) { %>
        <div class="p-10 text-center text-slate-400">
            <i class="fas fa-comment-slash text-4xl mb-3 block text-slate-200"></i>
            <p class="text-sm">Hali izohlar yo'q. Birinchi bo'lib o'z fikringizni qoldiring!</p>
        </div>
        <%c++ } else { %>
        <div class="divide-y divide-slate-100">
            <%c++ for (auto& r : ratings) { auto rname = getOr(r, "reader_name", "Anonim"); auto rscore = getOr(r, "rating", "0"); auto review = getOr(r, "review"); auto rdate = getOr(r, "updated_at"); int score = 0; try { score = std::stoi(rscore); } catch (...) { score = 0; } %>
            <div class="px-6 py-4">
                <div class="flex items-start gap-3">
                    <div class="w-9 h-9 bg-gradient-to-br from-blue-500 to-purple-500 rounded-full flex items-center justify-center text-white font-bold text-sm flex-shrink-0 shadow-md">
                        <%c++ BookDetail_tmp_stream << (rname.empty() ? "?" : rname.substr(0, 1)); %>
                    </div>
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap">
                            <p class="font-semibold text-sm text-slate-800"><%c++ BookDetail_tmp_stream << rname; %></p>
                            <span class="text-yellow-500 text-xs"><%c++ for (int s = 1; s <= 5; s++) { BookDetail_tmp_stream << (s <= score ? "★" : "☆"); } %></span>
                            <%c++ if (!rdate.empty()) { %>
                            <span class="text-xs text-slate-400"><%c++ BookDetail_tmp_stream << (rdate.size() > 10 ? rdate.substr(0, 10) : rdate); %></span>
                            <%c++ } %>
                        </div>
                        <%c++ if (!review.empty()) { %>
                        <p class="text-sm text-slate-600 mt-1 leading-relaxed"><%c++ BookDetail_tmp_stream << review; %></p>
                        <%c++ } %>
                    </div>
                </div>
            </div>
            <%c++ } %>
        </div>
        <%c++ } %>
    </div>
</main>

<!-- Baholash modali -->
<%c++ if (loggedIn) { %>
<div id="rate-modal" class="fixed inset-0 bg-black/60 backdrop-blur-sm z-50 items-center justify-center p-4" style="display:none">
    <div class="auth-card scale-in" style="max-width:380px;padding:2rem">
        <h3 class="text-lg font-extrabold text-slate-800 mb-4 text-center">Kitobni baholang</h3>
        <form method="POST" action="/kitob/<%c++ BookDetail_tmp_stream << bookId; %>/baholash">
            <input type="hidden" name="csrf_token" value="<%c++ BookDetail_tmp_stream << csrf; %>">
            <div class="flex justify-center gap-2 mb-4" id="stars">
                <%c++ for (int s = 1; s <= 5; s++) { %>
                <label class="star-label" onclick="setStar(<%c++ BookDetail_tmp_stream << s; %>)">
                    <input type="radio" name="score" value="<%c++ BookDetail_tmp_stream << s; %>" class="hidden">★
                </label>
                <%c++ } %>
            </div>
            <textarea name="review" placeholder="Fikringiz (ixtiyoriy)..." class="input-premium mb-4 resize-none" rows="3"></textarea>
            <div class="flex gap-3">
                <button type="button" onclick="document.getElementById('rate-modal').style.display='none'" class="btn-prem btn-prem-ghost flex-1 py-2.5 border border-slate-200">Bekor</button>
                <button type="submit" class="btn-prem btn-prem-accent flex-1 py-2.5">Saqlash</button>
            </div>
        </form>
    </div>
</div>
<script>
function setStar(n) { document.querySelectorAll('.star-label').forEach((l,i) => { l.style.color = i < n ? '#f59e0b' : '#d1d5db'; }); }
document.getElementById('rate-modal').addEventListener('click', function(e) { if (e.target === this) this.style.display = 'none'; });
</script>
<%c++ } %>

<%c++ if (!similar.empty()) { %>
<section class="max-w-4xl mx-auto px-4 py-8 fade-in-up-delay-3">
    <div class="section-heading-premium mb-5">
        <span class="icon-wrap"><i class="fas fa-layer-group text-sm"></i></span>
        O'xshash kitoblar
    </div>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-5 gap-4">
    <%c++ for (auto& s : similar) { auto sid = getOr(s, "id"); auto stitle = getOr(s, "title", "Kitob"); auto sauth = getOr(s, "author_name"); auto scover = getOr(s, "cover_image"); auto srate = getOr(s, "average_rating"); %>
    <a href="/kitob/<%c++ BookDetail_tmp_stream << sid; %>" class="book-card-premium">
        <div class="h-36 bg-slate-100 flex items-center justify-center book-cover-shimmer">
            <%c++ if (!scover.empty()) { %><img src="<%c++ BookDetail_tmp_stream << scover; %>" class="w-full h-full object-cover" alt=""><%c++ } else { %><i class="fas fa-book text-slate-300 text-3xl"></i><%c++ } %>
        </div>
        <div class="p-2.5">
            <p class="font-semibold text-xs text-slate-800 line-clamp-2 leading-snug"><%c++ BookDetail_tmp_stream << stitle; %></p>
            <p class="text-[10px] text-slate-400 mt-0.5 truncate"><%c++ BookDetail_tmp_stream << sauth; %></p>
            <%c++ if (!srate.empty()) { %><span class="inline-block mt-1 pill-premium pill-amber text-[9px]">★ <%c++ BookDetail_tmp_stream << srate; %></span><%c++ } %>
        </div>
    </a>
    <%c++ } %>
    </div>
</section>
<%c++ } %>

<footer class="footer-premium py-6 px-4 text-center text-xs">
    <p>© 2026 TATU Kutubxona</p>
</footer>
</body>
</html>
