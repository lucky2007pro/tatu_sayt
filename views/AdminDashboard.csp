<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TATU | Admin Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style> body { font-family: 'Inter', sans-serif; background: #f1f5f9; } </style>
</head>
<body class="min-h-screen bg-slate-50">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& tBooks  = @@.get<std::string>("total_books");
    auto& tRead   = @@.get<std::string>("total_readers");
    auto& tResvr  = @@.get<std::string>("total_reservations");
    auto& tLibs   = @@.get<std::string>("total_libraries");
    auto& tIssues = @@.get<std::string>("total_issues");
    auto& pCards  = @@.get<std::string>("pending_cards");
    auto& readers = @@.get<RowList>("readers");
    int pendingCount = 0;
    for (auto& r : readers) {
        if (getOr(r, "is_active") == "False") pendingCount++;
    }
%>

<nav class="bg-slate-900 text-white sticky top-0 z-50 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-7 h-7 bg-blue-500 rounded-lg flex items-center justify-center font-black text-xs">T</div>
            <span class="font-bold text-sm">TATU Admin</span>
            <span class="text-slate-500 text-xs">|</span>
            <span class="text-slate-300 text-xs font-medium">Dashboard</span>
        </div>
        <div class="flex items-center gap-1 text-xs">
            <a href="/admin/dashboard" class="px-3 py-1.5 rounded-lg bg-slate-700 text-white transition">Panel</a>
            <a href="/admin/readers" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">O'quvchilar</a>
            <a href="/admin/books" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Kitoblar</a>
            <a href="/admin/bronlar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Bronlar</a>
            <a href="/admin/berishlar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Berishlar</a>
            <a href="/admin/kartalar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Kartalar</a>
            <a href="/admin/analitika" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition"><i class="fas fa-chart-bar mr-1"></i>Analitika</a>
            <a href="/" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-400 transition text-xs"><i class="fas fa-external-link-alt mr-1"></i>Sayt</a>
            <a href="/admin/chiqish" class="ml-2 px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white transition"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</nav>

<div class="max-w-7xl mx-auto px-4 py-6">
    <h1 class="text-2xl font-extrabold text-slate-800 mb-6">Dashboard</h1>

    <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 mb-6">
        <a href="/admin/books" class="bg-blue-600 text-white rounded-2xl p-5 shadow-md hover:shadow-lg transition">
            <i class="fas fa-book text-blue-200 text-2xl mb-2 block"></i>
            <div class="text-3xl font-black"><%c++ AdminDashboard_tmp_stream << tBooks; %></div>
            <div class="text-blue-200 text-xs mt-1">Kitoblar</div>
        </a>
        <a href="/admin/readers" class="bg-green-600 text-white rounded-2xl p-5 shadow-md hover:shadow-lg transition">
            <i class="fas fa-users text-green-200 text-2xl mb-2 block"></i>
            <div class="text-3xl font-black"><%c++ AdminDashboard_tmp_stream << tRead; %></div>
            <div class="text-green-200 text-xs mt-1">O'quvchilar</div>
        </a>
        <div class="bg-orange-500 text-white rounded-2xl p-5 shadow-md">
            <i class="fas fa-calendar-check text-orange-200 text-2xl mb-2 block"></i>
            <div class="text-3xl font-black"><%c++ AdminDashboard_tmp_stream << tResvr; %></div>
            <div class="text-orange-200 text-xs mt-1">Bronlar</div>
        </div>
        <div class="bg-cyan-600 text-white rounded-2xl p-5 shadow-md">
            <i class="fas fa-book-open text-cyan-200 text-2xl mb-2 block"></i>
            <div class="text-3xl font-black"><%c++ AdminDashboard_tmp_stream << tIssues; %></div>
            <div class="text-cyan-200 text-xs mt-1">O'qishga olingan</div>
        </div>
        <div class="bg-slate-700 text-white rounded-2xl p-5 shadow-md">
            <i class="fas fa-building text-slate-400 text-2xl mb-2 block"></i>
            <div class="text-3xl font-black"><%c++ AdminDashboard_tmp_stream << tLibs; %></div>
            <div class="text-slate-400 text-xs mt-1">Kutubxonalar</div>
        </div>
        <a href="/admin/kartalar" class="bg-purple-600 text-white rounded-2xl p-5 shadow-md hover:shadow-lg transition relative">
            <i class="fas fa-id-card text-purple-200 text-2xl mb-2 block"></i>
            <div class="text-3xl font-black"><%c++ AdminDashboard_tmp_stream << pCards; %></div>
            <div class="text-purple-200 text-xs mt-1">Tasdiq kutayotgan kartalar</div>
            <%c++ if (pCards != "0" && !pCards.empty()) { %>
            <span class="absolute -top-1 -right-1 w-3 h-3 bg-orange-400 rounded-full animate-ping"></span>
            <%c++ } %>
        </a>
    </div>

    <!-- Kutayotgan o'quvchilar -->
    <%c++ if (pendingCount > 0) { %>
    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100">
            <h2 class="font-bold text-slate-800 flex items-center gap-2">
                <i class="fas fa-user-clock text-orange-500"></i>
                Bloklangan / nofaol o'quvchilar
            </h2>
            <a href="/admin/readers" class="text-xs text-blue-600 font-semibold hover:text-blue-700">Hammasini ko'rish →</a>
        </div>
        <div class="divide-y divide-slate-100">
            <%c++ for (auto& r : readers) {
                if (getOr(r, "is_active") == "True") continue; %>
            <div class="flex items-center justify-between px-6 py-3">
                <div>
                    <p class="font-semibold text-sm text-slate-800"><%c++ AdminDashboard_tmp_stream << getOr(r, "fullname", "—"); %></p>
                    <p class="text-xs text-slate-400"><%c++ AdminDashboard_tmp_stream << getOr(r, "card_id"); %> &bull; <%c++ AdminDashboard_tmp_stream << getOr(r, "phone"); %></p>
                </div>
                <a href="/admin/readers" class="text-xs font-semibold bg-orange-100 text-orange-700 px-3 py-1.5 rounded-lg hover:bg-orange-200 transition">
                    Ko'rish
                </a>
            </div>
            <%c++ } %>
        </div>
    </div>
    <%c++ } else { %>
    <div class="bg-white rounded-2xl border border-slate-200 p-8 text-center text-slate-400 shadow-sm">
        <i class="fas fa-check-circle text-green-400 text-3xl mb-3 block"></i>
        <p class="text-sm">Barcha o'quvchilar faol holatda.</p>
    </div>
    <%c++ } %>
</div>
</body>
</html>
