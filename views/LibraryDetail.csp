<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <%c++ LibraryDetail_tmp_stream << PREMIUM_HEAD; %>
    <title>TATU Kutubxona | Kutubxona</title>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& lib      = @@.get<Row>("library");
    auto& books    = @@.get<RowList>("books");
    auto  loggedIn = @@.get<bool>("is_logged_in");
    auto& name     = @@.get<std::string>("reader_name");
    auto libName   = getOr(lib, "name", "Kutubxona");
    auto address   = getOr(lib, "address");
    auto phone     = getOr(lib, "phone");
    auto email     = getOr(lib, "email");
    auto hours     = getOr(lib, "working_hours");
    auto lat       = getOr(lib, "latitude");
    auto lon       = getOr(lib, "longitude");
%>

<!-- NAVBAR -->
<nav class="navbar-premium sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between gap-4">
        <a href="/" class="flex items-center gap-2.5">
            <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center text-white font-black text-sm shadow-md">T</div>
            <span class="font-extrabold text-slate-800 tracking-tight">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <a href="/kutubxonalar" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-2 rounded-lg hover:bg-blue-50/60 transition"><i class="fas fa-arrow-left mr-1"></i>Kutubxonalar</a>
            <%c++ if (loggedIn) { %>
            <a href="/kabinet" class="text-xs font-semibold text-slate-600 border border-slate-200 px-3 py-2 rounded-lg hover:border-blue-400 hover:text-blue-600 transition"><i class="fas fa-user mr-1"></i><%c++ LibraryDetail_tmp_stream << name; %></a>
            <%c++ } else { %>
            <a href="/kirish" class="btn-prem btn-prem-primary text-xs py-2 px-4">Kirish</a>
            <%c++ } %>
        </div>
    </div>
</nav>

<main class="max-w-6xl mx-auto px-4 py-8 flex-1 page-transition">

    <!-- Kutubxona info kartasi -->
    <div class="card-premium overflow-hidden mb-8 fade-in-up">
        <div class="hero-premium px-6 py-10" style="position:relative">
            <div class="flex items-start gap-5 relative z-10">
                <div class="w-16 h-16 bg-white/15 backdrop-blur rounded-2xl flex items-center justify-center flex-shrink-0 border border-white/20">
                    <i class="fas fa-building text-3xl text-white"></i>
                </div>
                <div class="flex-1">
                    <h1 class="text-2xl font-extrabold mb-1"><%c++ LibraryDetail_tmp_stream << libName; %></h1>
                    <%c++ if (!address.empty()) { %>
                    <p class="text-blue-200 text-sm flex items-center gap-1.5"><i class="fas fa-map-marker-alt"></i><%c++ LibraryDetail_tmp_stream << address; %></p>
                    <%c++ } %>
                </div>
                <div class="flex-shrink-0">
                    <span class="pill-premium bg-white/15 text-white border border-white/20 text-sm py-1.5 px-4">
                        <i class="fas fa-book mr-1"></i><%c++ LibraryDetail_tmp_stream << books.size(); %> kitob
                    </span>
                </div>
            </div>
        </div>

        <div class="p-6 grid grid-cols-1 md:grid-cols-3 gap-4">
            <%c++ if (!phone.empty()) { %>
            <div class="flex items-center gap-3 text-slate-600">
                <div class="w-10 h-10 bg-blue-50 rounded-xl flex items-center justify-center flex-shrink-0"><i class="fas fa-phone text-blue-500 text-sm"></i></div>
                <div><p class="text-xs text-slate-400">Telefon</p><p class="text-sm font-semibold"><%c++ LibraryDetail_tmp_stream << phone; %></p></div>
            </div>
            <%c++ } %>
            <%c++ if (!email.empty()) { %>
            <div class="flex items-center gap-3 text-slate-600">
                <div class="w-10 h-10 bg-purple-50 rounded-xl flex items-center justify-center flex-shrink-0"><i class="fas fa-envelope text-purple-500 text-sm"></i></div>
                <div><p class="text-xs text-slate-400">Email</p><p class="text-sm font-semibold"><%c++ LibraryDetail_tmp_stream << email; %></p></div>
            </div>
            <%c++ } %>
            <%c++ if (!hours.empty()) { %>
            <div class="flex items-center gap-3 text-slate-600">
                <div class="w-10 h-10 bg-green-50 rounded-xl flex items-center justify-center flex-shrink-0"><i class="fas fa-clock text-green-500 text-sm"></i></div>
                <div><p class="text-xs text-slate-400">Ish vaqti</p><p class="text-sm font-semibold"><%c++ LibraryDetail_tmp_stream << hours; %></p></div>
            </div>
            <%c++ } %>
        </div>

        <%c++ if (!lat.empty() && !lon.empty() && lat != "0" && lon != "0") { %>
        <div class="border-t border-slate-100">
            <iframe src="https://maps.google.com/maps?q=<%c++ LibraryDetail_tmp_stream << lat; %>,<%c++ LibraryDetail_tmp_stream << lon; %>&z=15&output=embed"
                class="w-full h-64 border-0" loading="lazy" allowfullscreen></iframe>
        </div>
        <div class="px-6 py-3 border-t border-slate-100">
            <a href="https://www.google.com/maps?q=<%c++ LibraryDetail_tmp_stream << lat; %>,<%c++ LibraryDetail_tmp_stream << lon; %>"
               target="_blank" class="link-premium text-sm"><i class="fas fa-directions mr-1"></i>Google Maps da ochish</a>
        </div>
        <%c++ } %>
    </div>

    <!-- Kitoblar -->
    <div class="fade-in-up-delay-1">
        <div class="section-heading-premium mb-5">
            <span class="icon-wrap"><i class="fas fa-book-open text-sm"></i></span>
            Ushbu kutubxona kitoblari
            <span class="pill-premium pill-blue ml-2"><%c++ LibraryDetail_tmp_stream << books.size(); %></span>
        </div>

        <%c++ if (books.empty()) { %>
        <div class="card-premium p-10 text-center text-slate-400">
            <i class="fas fa-book-open text-4xl mb-3 block text-slate-200"></i>
            <p class="text-sm">Bu kutubxona uchun kitoblar topilmadi.</p>
        </div>
        <%c++ } else { %>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            <%c++ for (auto& b : books) {
                auto bid     = getOr(b, "id");
                auto btitle  = getOr(b, "title", "Noma'lum kitob");
                auto bauthor = getOr(b, "author_name");
                auto bsec    = getOr(b, "section_name");
                auto brating = getOr(b, "average_rating");
                auto bstat   = getOr(b, "availability_status", "available");
                bool isAvail = (bstat == "available");
                bool isIssued = (bstat == "issued");
            %>
            <a href="/kitob/<%c++ LibraryDetail_tmp_stream << bid; %>"
               class="card-premium p-4 flex flex-col gap-2 hover-lift">
                <div class="flex items-start justify-between gap-2">
                    <h3 class="font-semibold text-slate-800 text-sm leading-snug flex-1"><%c++ LibraryDetail_tmp_stream << btitle; %></h3>
                    <span class="pill-premium flex-shrink-0
                        <%c++ if (isAvail) { %>pill-emerald<%c++ } else if (isIssued) { %>pill-amber<%c++ } else { %>pill-rose<%c++ } %>">
                        <%c++ if (isAvail) { %>✅<%c++ } else if (isIssued) { %>📤<%c++ } else { %>🔖<%c++ } %>
                    </span>
                </div>
                <%c++ if (!bauthor.empty()) { %>
                <p class="text-xs text-slate-400"><i class="fas fa-user-edit mr-1"></i><%c++ LibraryDetail_tmp_stream << bauthor; %></p>
                <%c++ } %>
                <div class="flex items-center justify-between mt-auto pt-2 border-t border-slate-100">
                    <%c++ if (!bsec.empty()) { %>
                    <span class="pill-premium pill-slate"><%c++ LibraryDetail_tmp_stream << bsec; %></span>
                    <%c++ } %>
                    <%c++ if (!brating.empty() && brating != "0" && brating != "0.0") { %>
                    <span class="pill-premium pill-amber">★ <%c++ LibraryDetail_tmp_stream << brating; %></span>
                    <%c++ } %>
                </div>
            </a>
            <%c++ } %>
        </div>
        <%c++ } %>
    </div>
</main>

<footer class="footer-premium py-6 px-4 text-center text-xs mt-auto">
    <p>© 2026 TATU Kutubxona</p>
</footer>
</body>
</html>
