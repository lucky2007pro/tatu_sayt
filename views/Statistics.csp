<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <%c++ Statistics_tmp_stream << PREMIUM_HEAD; %>
    <title>TATU Kutubxona | Statistika</title>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& popular   = @@.get<RowList>("popular");
    auto& tBooks    = @@.get<std::string>("total_books");
    auto& tReaders  = @@.get<std::string>("total_readers");
    auto& tResrvs   = @@.get<std::string>("total_reservations");
    auto& tIssues   = @@.get<std::string>("total_issues");
    auto& tLibs     = @@.get<std::string>("total_libraries");
    auto& tSecs     = @@.get<std::string>("total_sections");
    auto  loggedIn  = @@.get<bool>("is_logged_in");
    auto& name      = @@.get<std::string>("reader_name");
%>

<!-- NAVBAR -->
<nav class="navbar-premium sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
            <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center text-white font-black text-sm shadow-md">T</div>
            <span class="font-extrabold text-slate-800 tracking-tight">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <a href="/" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-2 rounded-lg hover:bg-blue-50/60 transition">
                <i class="fas fa-home mr-1"></i>Kitoblar
            </a>
            <%c++ if (loggedIn) { %>
            <a href="/kabinet" class="text-xs font-semibold text-slate-700 border border-slate-200 px-3 py-2 rounded-lg hover:border-blue-400 hover:text-blue-600 transition">
                <i class="fas fa-user mr-1"></i><%c++ Statistics_tmp_stream << name; %>
            </a>
            <%c++ } else { %>
            <a href="/kirish" class="btn-prem btn-prem-primary text-xs py-2 px-4">Kirish</a>
            <%c++ } %>
        </div>
    </div>
</nav>

<main class="max-w-5xl mx-auto px-4 py-8 flex-1 page-transition">

    <!-- Sarlavha -->
    <div class="mb-8 fade-in-up">
        <div class="section-heading-premium text-2xl">
            <span class="icon-wrap"><i class="fas fa-chart-bar text-sm"></i></span>
            Kutubxona statistikasi
        </div>
        <p class="text-sm text-slate-400 mt-2 ml-12">Tizim bo'yicha umumiy ko'rsatkichlar</p>
    </div>

    <!-- Statistika kartlari -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-10">
        <div class="stat-card-premium stat-blue fade-in-up">
            <i class="fas fa-book text-white/30 text-2xl mb-3 block"></i>
            <div class="stat-value count-up"><%c++ Statistics_tmp_stream << tBooks; %></div>
            <div class="stat-label">Umumiy kitoblar</div>
        </div>
        <div class="stat-card-premium stat-green fade-in-up-delay-1">
            <i class="fas fa-users text-white/30 text-2xl mb-3 block"></i>
            <div class="stat-value count-up"><%c++ Statistics_tmp_stream << tReaders; %></div>
            <div class="stat-label">O'quvchilar</div>
        </div>
        <div class="stat-card-premium stat-orange fade-in-up-delay-2">
            <i class="fas fa-calendar-check text-white/30 text-2xl mb-3 block"></i>
            <div class="stat-value count-up"><%c++ Statistics_tmp_stream << tResrvs; %></div>
            <div class="stat-label">Bronlar</div>
        </div>
        <div class="stat-card-premium stat-purple fade-in-up-delay-3">
            <i class="fas fa-hand-holding-heart text-white/30 text-2xl mb-3 block"></i>
            <div class="stat-value count-up"><%c++ Statistics_tmp_stream << tIssues; %></div>
            <div class="stat-label">Berilgan</div>
        </div>
        <div class="stat-card-premium stat-sky fade-in-up">
            <i class="fas fa-university text-white/30 text-2xl mb-3 block"></i>
            <div class="stat-value count-up"><%c++ Statistics_tmp_stream << tLibs; %></div>
            <div class="stat-label">Kutubxonalar</div>
        </div>
        <div class="stat-card-premium stat-rose fade-in-up-delay-1">
            <i class="fas fa-bookmark text-white/30 text-2xl mb-3 block"></i>
            <div class="stat-value count-up"><%c++ Statistics_tmp_stream << tSecs; %></div>
            <div class="stat-label">Bo'limlar</div>
        </div>
    </div>

    <!-- Top kitoblar -->
    <%c++ if (!popular.empty()) { %>
    <div class="fade-in-up-delay-2">
        <div class="section-heading-premium mb-5">
            <span class="icon-wrap" style="background:var(--gradient-gold)"><i class="fas fa-trophy text-sm"></i></span>
            Top ommabop kitoblar
        </div>
        <div class="card-premium overflow-hidden">
            <%c++ int rank = 1; for (auto& b : popular) { %>
            <div class="rank-card border-0 rounded-none border-b border-slate-100 last:border-0">
                <div class="rank-badge <%c++ if (rank == 1) { %>rank-1<%c++ } else if (rank == 2) { %>rank-2<%c++ } else if (rank == 3) { %>rank-3<%c++ } else { %>rank-other<%c++ } %>">
                    <%c++ Statistics_tmp_stream << rank++; %>
                </div>
                <div class="flex-1 min-w-0">
                    <a href="/kitob/<%c++ Statistics_tmp_stream << getOr(b, "id"); %>"
                       class="font-semibold text-sm text-slate-800 hover:text-blue-600 transition truncate block">
                        <%c++ Statistics_tmp_stream << getOr(b, "title", "Kitob"); %>
                    </a>
                    <p class="text-xs text-slate-400 truncate mt-0.5"><%c++ Statistics_tmp_stream << getOr(b, "author_name"); %></p>
                </div>
                <div class="flex items-center gap-3 flex-shrink-0">
                    <%c++ auto br = getOr(b, "average_rating"); if (!br.empty() && br != "0" && br != "0.0") { %>
                    <span class="pill-premium pill-amber">★ <%c++ Statistics_tmp_stream << br; %></span>
                    <%c++ } %>
                    <%c++ auto bv = getOr(b, "view_count"); if (!bv.empty() && bv != "0") { %>
                    <span class="text-xs text-slate-400"><i class="fas fa-eye mr-1"></i><%c++ Statistics_tmp_stream << bv; %></span>
                    <%c++ } %>
                </div>
            </div>
            <%c++ } %>
        </div>
    </div>
    <%c++ } %>
</main>

<footer class="footer-premium py-6 px-4 text-center text-xs mt-auto">
    <p>© 2026 TATU Kutubxona — Online band qilish tizimi</p>
</footer>
</body>
</html>
