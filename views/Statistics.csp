<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TATU Kutubxona | Statistika</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style> body { font-family: 'Inter', sans-serif; background: #f1f5f9; } </style>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& popular   = @@.get<RowList>("popular");
    auto& tBooks    = @@.get<std::string>("total_books");
    auto& tReaders  = @@.get<std::string>("total_readers");
    auto& tResrvs   = @@.get<std::string>("total_reservations");
    auto& tIssues   = @@.get<std::string>("total_issues");
    auto& tLibs     = @@.get<std::string>("total_libraries");
    auto& tSecs     = @@.get<std::string>("total_sections");
    auto  loggedIn  = @@.get<bool>("is_logged_in");
    auto& name      = @@.get<std::string>("reader_name");
%>

<nav class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
    <div class="max-w-5xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
            <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center text-white font-black text-xs">T</div>
            <span class="font-bold text-slate-800">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <a href="/" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                <i class="fas fa-home mr-1"></i>Kitoblar
            </a>
            <%c++ if (loggedIn) { %>
            <a href="/kabinet" class="text-xs font-semibold text-slate-700 border border-slate-200 px-3 py-1.5 rounded-lg hover:border-blue-400 hover:text-blue-600 transition">
                <i class="fas fa-user mr-1"></i><%c++ Statistics_tmp_stream << name; %>
            </a>
            <%c++ } else { %>
            <a href="/kirish" class="text-xs font-semibold bg-blue-600 text-white px-4 py-1.5 rounded-lg hover:bg-blue-700 transition">Kirish</a>
            <%c++ } %>
        </div>
    </div>
</nav>

<main class="max-w-5xl mx-auto px-4 py-8 flex-1">
    <h1 class="text-2xl font-extrabold text-slate-800 mb-6 flex items-center gap-2">
        <i class="fas fa-chart-bar text-blue-600"></i> Kutubxona statistikasi
    </h1>

    <!-- Raqamlar -->
    <div class="grid grid-cols-2 md:grid-cols-3 gap-4 mb-10">
        <div class="bg-gradient-to-br from-blue-500 to-blue-600 text-white rounded-2xl p-5 shadow-md">
            <i class="fas fa-book text-blue-200 text-2xl mb-3 block"></i>
            <div class="text-3xl font-extrabold"><%c++ Statistics_tmp_stream << tBooks; %></div>
            <div class="text-blue-200 text-xs mt-1 font-medium">Umumiy kitoblar</div>
        </div>
        <div class="bg-gradient-to-br from-green-500 to-green-600 text-white rounded-2xl p-5 shadow-md">
            <i class="fas fa-users text-green-200 text-2xl mb-3 block"></i>
            <div class="text-3xl font-extrabold"><%c++ Statistics_tmp_stream << tReaders; %></div>
            <div class="text-green-200 text-xs mt-1 font-medium">O'quvchilar</div>
        </div>
        <div class="bg-gradient-to-br from-orange-500 to-orange-600 text-white rounded-2xl p-5 shadow-md">
            <i class="fas fa-calendar-check text-orange-200 text-2xl mb-3 block"></i>
            <div class="text-3xl font-extrabold"><%c++ Statistics_tmp_stream << tResrvs; %></div>
            <div class="text-orange-200 text-xs mt-1 font-medium">Bronlar</div>
        </div>
        <div class="bg-gradient-to-br from-purple-500 to-purple-600 text-white rounded-2xl p-5 shadow-md">
            <i class="fas fa-hand-holding-heart text-purple-200 text-2xl mb-3 block"></i>
            <div class="text-3xl font-extrabold"><%c++ Statistics_tmp_stream << tIssues; %></div>
            <div class="text-purple-200 text-xs mt-1 font-medium">Berilgan</div>
        </div>
        <div class="bg-gradient-to-br from-sky-500 to-sky-600 text-white rounded-2xl p-5 shadow-md">
            <i class="fas fa-university text-sky-200 text-2xl mb-3 block"></i>
            <div class="text-3xl font-extrabold"><%c++ Statistics_tmp_stream << tLibs; %></div>
            <div class="text-sky-200 text-xs mt-1 font-medium">Kutubxonalar</div>
        </div>
        <div class="bg-gradient-to-br from-rose-500 to-rose-600 text-white rounded-2xl p-5 shadow-md">
            <i class="fas fa-bookmark text-rose-200 text-2xl mb-3 block"></i>
            <div class="text-3xl font-extrabold"><%c++ Statistics_tmp_stream << tSecs; %></div>
            <div class="text-rose-200 text-xs mt-1 font-medium">Bo'limlar</div>
        </div>
    </div>

    <!-- Top kitoblar -->
    <%c++ if (!popular.empty()) { %>
    <div>
        <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
            <i class="fas fa-trophy text-yellow-500"></i> Top ommabop kitoblar
        </h2>
        <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
            <%c++ int rank = 1; for (auto& b : popular) { %>
            <div class="flex items-center gap-4 px-5 py-4 border-b border-slate-100 last:border-0 hover:bg-slate-50 transition">
                <div class="w-9 h-9 flex-shrink-0 flex items-center justify-center rounded-xl font-black text-base
                    <%c++ if (rank == 1) { %>bg-yellow-400 text-white<%c++ } else if (rank == 2) { %>bg-slate-300 text-white<%c++ } else if (rank == 3) { %>bg-orange-400 text-white<%c++ } else { %>bg-slate-100 text-slate-500<%c++ } %>">
                    <%c++ Statistics_tmp_stream << rank++; %>
                </div>
                <div class="flex-1 min-w-0">
                    <a href="/kitob/<%c++ Statistics_tmp_stream << getOr(b, "id"); %>"
                       class="font-semibold text-sm text-slate-800 hover:text-blue-600 transition truncate block">
                        <%c++ Statistics_tmp_stream << getOr(b, "title", "Kitob"); %>
                    </a>
                    <p class="text-xs text-slate-400 truncate"><%c++ Statistics_tmp_stream << getOr(b, "author_name"); %></p>
                </div>
                <div class="flex items-center gap-3 flex-shrink-0">
                    <%c++ auto br = getOr(b, "average_rating"); if (!br.empty() && br != "0" && br != "0.0") { %>
                    <span class="text-xs bg-yellow-50 text-yellow-600 font-bold px-2 py-0.5 rounded-full">★ <%c++ Statistics_tmp_stream << br; %></span>
                    <%c++ } %>
                    <%c++ auto bv = getOr(b, "view_count"); if (!bv.empty() && bv != "0") { %>
                    <span class="text-xs text-slate-400"><i class="fas fa-eye mr-1"></i><%c++ Statistics_tmp_stream << bv; %></span>
                    <%c++ } %>
                </div>
            </div>
            <%c++ } %>
        </div>
    </div>
    <%c++ } %>
</main>

<footer class="bg-slate-800 text-slate-400 text-xs py-5 px-4 text-center mt-auto">
    © 2026 TATU Kutubxona
</footer>
</body>
</html>
