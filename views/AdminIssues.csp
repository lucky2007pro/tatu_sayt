<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TATU Kutubxona | Admin — Kitob berishlar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style> body { font-family: 'Inter', sans-serif; background: #f1f5f9; } </style>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& issues    = @@.get<RowList>("issues");
    auto& readers   = @@.get<RowList>("readers");
    auto& books     = @@.get<RowList>("books");
    auto& csrf      = @@.get<std::string>("csrf_token");
    auto& flashMsg  = @@.get<std::string>("flash_msg");
    auto& flashType = @@.get<std::string>("flash_type");
%>

<nav class="bg-slate-900 text-white sticky top-0 z-50 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-7 h-7 bg-blue-500 rounded-lg flex items-center justify-center font-black text-xs">T</div>
            <span class="font-bold text-sm">TATU Admin</span>
            <span class="text-slate-500 text-xs">|</span>
            <span class="text-slate-300 text-xs font-medium">Kitob berishlar</span>
        </div>
        <div class="flex items-center gap-1 text-xs">
            <a href="/admin/dashboard" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Panel</a>
            <a href="/admin/readers" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">O'quvchilar</a>
            <a href="/admin/books" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Kitoblar</a>
            <a href="/admin/bronlar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Bronlar</a>
            <a href="/admin/berishlar" class="px-3 py-1.5 rounded-lg bg-slate-700 text-white transition">Berishlar</a>
            <a href="/admin/kartalar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Kartalar</a>
            <a href="/admin/analitika" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition"><i class="fas fa-chart-bar mr-1"></i>Analitika</a>
            <a href="/admin/chiqish" class="ml-2 px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white transition">
                <i class="fas fa-sign-out-alt"></i>
            </a>
        </div>
    </div>
</nav>

<%c++ if (!flashMsg.empty()) { %>
<div class="max-w-7xl mx-auto px-4 pt-4">
    <div class="px-4 py-3 rounded-xl text-sm font-medium flex items-center gap-2
        <%c++ if (flashType == "success") { %>bg-green-50 border border-green-200 text-green-700<%c++ } else { %>bg-red-50 border border-red-200 text-red-700<%c++ } %>">
        <i class="fas <%c++ if (flashType == "success") { %>fa-check-circle<%c++ } else { %>fa-exclamation-circle<%c++ } %>"></i>
        <%c++ AdminIssues_tmp_stream << flashMsg; %>
    </div>
</div>
<%c++ } %>

<main class="max-w-7xl mx-auto px-4 py-8 flex-grow w-full">
    <div class="grid lg:grid-cols-3 gap-6">

        <!-- ── Yangi kitob berish formi ── -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6 sticky top-20">
                <div class="flex items-center gap-2 mb-5">
                    <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center">
                        <i class="fas fa-plus text-blue-600 text-sm"></i>
                    </div>
                    <h2 class="font-bold text-slate-800">Kitob berish</h2>
                </div>

                <form action="/admin/berishlar/yangi" method="POST" class="space-y-4">
                    <input type="hidden" name="csrf_token" value="<%c++ AdminIssues_tmp_stream << csrf; %>">
                    <div>
                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">O'quvchi</label>
                        <select name="reader" required
                                class="w-full text-sm px-3 py-2.5 rounded-lg border border-slate-200 focus:border-blue-400 outline-none bg-slate-50">
                            <option value="">— O'quvchi tanlang —</option>
                            <%c++ for (const auto& rd : readers) { %>
                            <option value="<%c++ AdminIssues_tmp_stream << getOr(rd, "id"); %>">
                                <%c++ AdminIssues_tmp_stream << getOr(rd, "fullname"); %>
                                (<%c++ AdminIssues_tmp_stream << getOr(rd, "card_id"); %>)
                            </option>
                            <%c++ } %>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">Kitob</label>
                        <select name="book" required
                                class="w-full text-sm px-3 py-2.5 rounded-lg border border-slate-200 focus:border-blue-400 outline-none bg-slate-50">
                            <option value="">— Kitob tanlang —</option>
                            <%c++ for (const auto& bk : books) { %>
                            <option value="<%c++ AdminIssues_tmp_stream << getOr(bk, "id"); %>">
                                <%c++ AdminIssues_tmp_stream << getOr(bk, "title"); %>
                            </option>
                            <%c++ } %>
                        </select>
                    </div>
                    <div>
                        <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">Qaytarish sanasi</label>
                        <input type="date" name="return_date" required id="returnDate"
                               class="w-full text-sm px-3 py-2.5 rounded-lg border border-slate-200 focus:border-blue-400 outline-none bg-slate-50">
                    </div>
                    <button type="submit"
                            class="w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold py-2.5 rounded-lg transition">
                        <i class="fas fa-paper-plane mr-1.5"></i>Kitob berish
                    </button>
                </form>
            </div>
        </div>

        <!-- ── Berishlar jadvali ── -->
        <div class="lg:col-span-2">
            <div class="flex items-center justify-between mb-4">
                <div>
                    <h1 class="text-xl font-bold text-slate-800">
                        <i class="fas fa-book-open text-blue-600 mr-2"></i>Kitob berishlar tarixi
                    </h1>
                    <p class="text-sm text-slate-400 mt-0.5">Jami <strong><%c++ AdminIssues_tmp_stream << issues.size(); %></strong> ta yozuv</p>
                </div>
                <input type="text" id="searchInput" placeholder="Qidirish..."
                       oninput="filterTable()"
                       class="text-sm px-3 py-2 rounded-lg border border-slate-200 focus:border-blue-400 outline-none bg-white w-44">
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
                <%c++ if (issues.empty()) { %>
                <div class="text-center py-16">
                    <i class="fas fa-book-open text-5xl text-slate-200 mb-4 block"></i>
                    <p class="text-slate-400 font-medium">Hali hech qanday kitob berilmagan.</p>
                </div>
                <%c++ } else { %>
                <div class="overflow-x-auto">
                    <table class="w-full text-sm">
                        <thead class="bg-slate-50 border-b border-slate-100">
                            <tr>
                                <th class="text-left px-4 py-3 text-xs font-bold text-slate-500 uppercase">#</th>
                                <th class="text-left px-4 py-3 text-xs font-bold text-slate-500 uppercase">O'quvchi</th>
                                <th class="text-left px-4 py-3 text-xs font-bold text-slate-500 uppercase">Kitob</th>
                                <th class="text-left px-4 py-3 text-xs font-bold text-slate-500 uppercase">Berilgan</th>
                                <th class="text-left px-4 py-3 text-xs font-bold text-slate-500 uppercase">Qaytarish</th>
                                <th class="text-left px-4 py-3 text-xs font-bold text-slate-500 uppercase">Holat</th>
                            </tr>
                        </thead>
                        <tbody>
                        <%c++
                            int idx = 1;
                            for (const auto& iss : issues) {
                                std::string retDate = getOr(iss, "return_date");
                                bool overdue = false;
                        %>
                            <tr class="border-b border-slate-50 hover:bg-slate-50 transition issue-row">
                                <td class="px-4 py-3 text-slate-400 font-mono text-xs"><%c++ AdminIssues_tmp_stream << idx++; %></td>
                                <td class="px-4 py-3 font-medium text-slate-700">
                                    <%c++ AdminIssues_tmp_stream << getOr(iss, "reader_name", "—"); %>
                                </td>
                                <td class="px-4 py-3">
                                    <a href="/kitob/<%c++ AdminIssues_tmp_stream << getOr(iss, "book"); %>"
                                       class="text-blue-600 hover:underline">
                                        <%c++ AdminIssues_tmp_stream << getOr(iss, "book_title", "—"); %>
                                    </a>
                                </td>
                                <td class="px-4 py-3 text-xs text-slate-500">
                                    <%c++ AdminIssues_tmp_stream << getOr(iss, "issue_date", "—"); %>
                                </td>
                                <td class="px-4 py-3 text-xs font-medium text-slate-700">
                                    <%c++ AdminIssues_tmp_stream << retDate; %>
                                </td>
                                <td class="px-4 py-3">
                                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-bold bg-amber-100 text-amber-700">
                                        <i class="fas fa-clock text-xs"></i> Faol
                                    </span>
                                </td>
                            </tr>
                        <%c++ } %>
                        </tbody>
                    </table>
                </div>
                <%c++ } %>
            </div>
        </div>

    </div>
</main>

<script>
// Minimal sana: bugun
document.getElementById('returnDate').min = new Date().toISOString().split('T')[0];
// Default: 14 kun
const d = new Date(); d.setDate(d.getDate() + 14);
document.getElementById('returnDate').value = d.toISOString().split('T')[0];

function filterTable() {
    const q = document.getElementById('searchInput').value.toLowerCase();
    document.querySelectorAll('.issue-row').forEach(row => {
        row.style.display = row.textContent.toLowerCase().includes(q) ? '' : 'none';
    });
}
</script>
</body>
</html>
