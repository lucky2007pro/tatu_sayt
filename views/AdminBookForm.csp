<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | Kitob</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style> body { font-family: 'Inter', sans-serif; background: #0f172a; color: #e2e8f0; } </style>
</head>
<body class="min-h-screen" style="background:#0f172a;color:#e2e8f0">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& book      = @@.get<Row>("book");
    auto& libraries = @@.get<RowList>("libraries");
    auto& sections  = @@.get<RowList>("sections");
    auto& csrf      = @@.get<std::string>("csrf_token");
    auto  editMode  = @@.get<bool>("edit_mode");
    auto  bookId    = getOr(book, "id");
    std::string formAction = editMode
        ? std::string("/admin/books/") + bookId + "/tahrir"
        : std::string("/admin/books/yangi");
    std::string pageTitle = editMode ? "Kitobni tahrirlash" : "Yangi kitob qo'shish";
%>

<nav class="bg-slate-900 text-white sticky top-0 z-50 shadow-lg border-b border-slate-700">
    <div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-7 h-7 bg-blue-500 rounded-lg flex items-center justify-center font-black text-xs">T</div>
            <span class="font-bold text-sm">TATU Admin</span>
            <span class="text-slate-500 text-xs">|</span>
            <span class="text-slate-300 text-xs font-medium">Kitob tahrirlash</span>
        </div>
        <div class="flex items-center gap-1 text-xs">
            <a href="/admin/dashboard" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Panel</a>
            <a href="/admin/readers" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">O'quvchilar</a>
            <a href="/admin/books" class="px-3 py-1.5 rounded-lg bg-slate-700 text-white transition">Kitoblar</a>
            <a href="/admin/bronlar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Bronlar</a>
            <a href="/admin/berishlar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Berishlar</a>
            <a href="/admin/kartalar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Kartalar</a>
            <a href="/admin/analitika" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition"><i class="fas fa-chart-bar mr-1"></i>Analitika</a>
            <a href="/admin/chiqish" class="ml-2 px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white transition"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</nav>

<div class="flex flex-col">
    <header class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex items-center justify-between">
        <h1 class="text-lg font-bold text-slate-100 flex items-center gap-2">
            <i class="fas fa-<%c++ AdminBookForm_tmp_stream << (editMode ? "edit" : "plus-circle"); %> text-blue-400"></i>
            <%c++ AdminBookForm_tmp_stream << pageTitle; %>
        </h1>
        <a href="/admin/books" class="text-xs text-slate-400 hover:text-slate-200 flex items-center gap-1.5 transition">
            <i class="fas fa-arrow-left"></i> Kitoblar ro'yxatiga qaytish
        </a>
    </header>

    <main class="flex-1 p-6">
        <div class="max-w-2xl mx-auto">
            <form method="POST" action="<%c++ AdminBookForm_tmp_stream << formAction; %>" class="space-y-5" enctype="multipart/form-data">
                <input type="hidden" name="csrf_token" value="<%c++ AdminBookForm_tmp_stream << csrf; %>">

                <!-- Asosiy ma'lumotlar -->
                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5">
                    <h2 class="text-sm font-bold text-slate-300 mb-4 flex items-center gap-2">
                        <i class="fas fa-info-circle text-blue-400"></i> Asosiy ma'lumotlar
                    </h2>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-1.5">Kitob nomi *</label>
                            <input type="text" name="title" required
                                   value="<%c++ AdminBookForm_tmp_stream << getOr(book, "title"); %>"
                                   class="w-full bg-slate-900 border border-slate-600 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:border-blue-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-1.5">Muallif *</label>
                            <input type="text" name="author_name" required
                                   value="<%c++ AdminBookForm_tmp_stream << getOr(book, "author_name"); %>"
                                   class="w-full bg-slate-900 border border-slate-600 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:border-blue-500 focus:outline-none">
                        </div>
                        <div class="grid grid-cols-2 gap-4">
                            <div>
                                <label class="block text-xs font-semibold text-slate-400 mb-1.5">ISBN</label>
                                <input type="text" name="isbn"
                                       value="<%c++ AdminBookForm_tmp_stream << getOr(book, "isbn"); %>"
                                       class="w-full bg-slate-900 border border-slate-600 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:border-blue-500 focus:outline-none">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-400 mb-1.5">Nashr sanasi</label>
                                <input type="date" name="published_date"
                                       value="<%c++ AdminBookForm_tmp_stream << getOr(book, "published_date"); %>"
                                       class="w-full bg-slate-900 border border-slate-600 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:border-blue-500 focus:outline-none">
                            </div>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-1.5">Tavsif</label>
                            <textarea name="description" rows="4"
                                      class="w-full bg-slate-900 border border-slate-600 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:border-blue-500 focus:outline-none resize-none"><%c++ AdminBookForm_tmp_stream << getOr(book, "description"); %></textarea>
                        </div>
                    </div>
                </div>

                <!-- Joylashuv -->
                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5">
                    <h2 class="text-sm font-bold text-slate-300 mb-4 flex items-center gap-2">
                        <i class="fas fa-map-marker-alt text-green-400"></i> Joylashuv
                    </h2>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-1.5">Kutubxona *</label>
                            <select name="library" required
                                    class="w-full bg-slate-900 border border-slate-600 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:border-blue-500 focus:outline-none">
                                <option value="">— Tanlang —</option>
                                <%c++ for (auto& lib : libraries) {
                                    auto lid = getOr(lib, "id");
                                    auto lname = getOr(lib, "name");
                                    bool sel = (lid == getOr(book, "library"));
                                %>
                                <option value="<%c++ AdminBookForm_tmp_stream << lid; %>" <%c++ if (sel) AdminBookForm_tmp_stream << "selected"; %>>
                                    <%c++ AdminBookForm_tmp_stream << lname; %>
                                </option>
                                <%c++ } %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-1.5">Bo'lim</label>
                            <select name="section"
                                    class="w-full bg-slate-900 border border-slate-600 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:border-blue-500 focus:outline-none">
                                <option value="">— Tanlang —</option>
                                <%c++ for (auto& sec : sections) {
                                    auto sid = getOr(sec, "id");
                                    auto sname = getOr(sec, "name");
                                    bool sel = (sid == getOr(book, "section"));
                                %>
                                <option value="<%c++ AdminBookForm_tmp_stream << sid; %>" <%c++ if (sel) AdminBookForm_tmp_stream << "selected"; %>>
                                    <%c++ AdminBookForm_tmp_stream << sname; %>
                                </option>
                                <%c++ } %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-1.5">Javon</label>
                            <input type="text" name="shelf"
                                   value="<%c++ AdminBookForm_tmp_stream << getOr(book, "shelf"); %>"
                                   placeholder="masalan: A3"
                                   class="w-full bg-slate-900 border border-slate-600 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:border-blue-500 focus:outline-none">
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-1.5">Qator</label>
                            <input type="text" name="row"
                                   value="<%c++ AdminBookForm_tmp_stream << getOr(book, "row"); %>"
                                   placeholder="masalan: 2"
                                   class="w-full bg-slate-900 border border-slate-600 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:border-blue-500 focus:outline-none">
                        </div>
                    </div>
                </div>

                <!-- Muqova rasmi -->
                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5">
                    <h2 class="text-sm font-bold text-slate-300 mb-4 flex items-center gap-2">
                        <i class="fas fa-image text-yellow-400"></i> Muqova rasmi
                    </h2>
                    <div class="flex items-start gap-5">
                        <div class="w-28 h-36 rounded-xl bg-slate-900 border border-slate-600 flex items-center justify-center overflow-hidden flex-shrink-0">
                            <%c++ auto existCover = getOr(book, "cover_image"); %>
                            <img id="coverPreview" src="<%c++ AdminBookForm_tmp_stream << existCover; %>" alt=""
                                 class="w-full h-full object-cover <%c++ if (existCover.empty()) AdminBookForm_tmp_stream << "hidden"; %>">
                            <i id="coverIcon" class="fas fa-book-open text-slate-600 text-2xl <%c++ if (!existCover.empty()) AdminBookForm_tmp_stream << "hidden"; %>"></i>
                        </div>
                        <div class="flex-1">
                            <label class="block text-xs font-semibold text-slate-400 mb-2">Rasm fayli (JPG, PNG, WEBP)</label>
                            <input type="file" name="cover_image" id="coverInput" accept="image/*"
                                   class="w-full text-xs text-slate-300 bg-slate-900 border border-slate-600 rounded-xl px-3 py-2 cursor-pointer
                                          file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold
                                          file:bg-blue-600 file:text-white hover:file:bg-blue-700">
                            <%c++ if (!existCover.empty()) { %>
                            <p class="text-[10px] text-slate-500 mt-2"><i class="fas fa-info-circle mr-1"></i>Mavjud rasm saqlanadi. Yangi fayl tanlasangiz, o'zgaradi.</p>
                            <%c++ } %>
                        </div>
                    </div>
                </div>

                <!-- Elektron kitob -->
                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5">
                    <h2 class="text-sm font-bold text-slate-300 mb-4 flex items-center gap-2">
                        <i class="fas fa-tablet-alt text-purple-400"></i> Elektron kitob (PDF)
                    </h2>
                    <%c++ auto existEbook = getOr(book, "ebook_file"); if (!existEbook.empty()) { %>
                    <div class="flex items-center gap-3 mb-3 p-3 bg-purple-900/20 border border-purple-700/50 rounded-xl">
                        <i class="fas fa-file-pdf text-purple-400 text-xl"></i>
                        <div>
                            <p class="text-xs font-semibold text-purple-300">Mavjud elektron kitob bor</p>
                            <a href="<%c++ AdminBookForm_tmp_stream << existEbook; %>" target="_blank"
                               class="text-[10px] text-purple-400 hover:underline">Ko'rish / yuklab olish</a>
                        </div>
                    </div>
                    <%c++ } %>
                    <label class="block text-xs font-semibold text-slate-400 mb-2">PDF fayl yuklash</label>
                    <input type="file" name="ebook_file" accept=".pdf,application/pdf"
                           class="w-full text-xs text-slate-300 bg-slate-900 border border-slate-600 rounded-xl px-3 py-2 cursor-pointer
                                  file:mr-3 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:text-xs file:font-bold
                                  file:bg-purple-600 file:text-white hover:file:bg-purple-700">
                </div>

                <!-- Qo'shimcha -->
                <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5">
                    <h2 class="text-sm font-bold text-slate-300 mb-4 flex items-center gap-2">
                        <i class="fas fa-list-alt text-cyan-400"></i> Qo'shimcha ma'lumotlar
                    </h2>
                    <div class="grid grid-cols-2 gap-4">
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-1.5">Til</label>
                            <select name="language" class="w-full bg-slate-900 border border-slate-600 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:border-blue-500 focus:outline-none">
                                <option value="">— Tanlang —</option>
                                <%c++ auto bookLang = getOr(book, "language"); %>
                                <option value="uz" <%c++ if (bookLang=="uz") AdminBookForm_tmp_stream << "selected"; %>>O'zbek</option>
                                <option value="ru" <%c++ if (bookLang=="ru") AdminBookForm_tmp_stream << "selected"; %>>Rus</option>
                                <option value="en" <%c++ if (bookLang=="en") AdminBookForm_tmp_stream << "selected"; %>>Ingliz</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-semibold text-slate-400 mb-1.5">Sahifalar soni</label>
                            <input type="number" name="total_pages" min="1"
                                   value="<%c++ AdminBookForm_tmp_stream << getOr(book, "total_pages"); %>"
                                   placeholder="masalan: 350"
                                   class="w-full bg-slate-900 border border-slate-600 rounded-xl px-4 py-2.5 text-sm text-slate-100 focus:border-blue-500 focus:outline-none">
                        </div>
                    </div>
                </div>

                <!-- Tugmalar -->
                <div class="flex items-center gap-3">
                    <button type="submit"
                            class="flex items-center gap-2 px-6 py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl text-sm transition">
                        <i class="fas fa-<%c++ AdminBookForm_tmp_stream << (editMode ? "save" : "plus"); %>"></i>
                        <%c++ AdminBookForm_tmp_stream << (editMode ? "Saqlash" : "Qo'shish"); %>
                    </button>
                    <a href="/admin/books"
                       class="px-6 py-2.5 border border-slate-600 text-slate-300 hover:bg-slate-700 rounded-xl text-sm transition">
                        Bekor qilish
                    </a>
                </div>
            </form>
        </div>
    </main>
</div>
<script>
document.getElementById('coverInput').addEventListener('change', function() {
    const file = this.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        const img  = document.getElementById('coverPreview');
        const icon = document.getElementById('coverIcon');
        img.src = e.target.result;
        img.classList.remove('hidden');
        if (icon) icon.classList.add('hidden');
    };
    reader.readAsDataURL(file);
});
</script>
</body>
</html>
