<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TATU Admin | Kitoblar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style> body { font-family: 'Inter', sans-serif; background: #f1f5f9; } </style>
</head>
<body class="min-h-screen bg-slate-50">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& books     = @@.get<RowList>("books");
    auto& flashMsg  = @@.get<std::string>("flash_msg");
    auto& flashType = @@.get<std::string>("flash_type");
    auto& csrf      = @@.get<std::string>("csrf_token");
%>

<nav class="bg-slate-900 text-white sticky top-0 z-50 shadow-lg">
    <div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-7 h-7 bg-blue-500 rounded-lg flex items-center justify-center font-black text-xs">T</div>
            <span class="font-bold text-sm">TATU Admin</span>
            <span class="text-slate-500 text-xs">|</span>
            <span class="text-slate-300 text-xs font-medium">Kitoblar</span>
        </div>
        <div class="flex items-center gap-1 text-xs">
            <a href="/admin/dashboard" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Panel</a>
            <a href="/admin/readers" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">O'quvchilar</a>
            <a href="/admin/books" class="px-3 py-1.5 rounded-lg bg-slate-700 text-white transition">Kitoblar</a>
            <a href="/admin/bronlar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Bronlar</a>
            <a href="/admin/berishlar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Berishlar</a>
            <a href="/admin/kartalar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Kartalar</a>
            <a href="/admin/analitika" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition"><i class="fas fa-chart-bar mr-1"></i>Analitika</a>
            <a href="/admin/chiqish" class="ml-2 px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white transition"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</nav>

<div class="max-w-7xl mx-auto px-4 py-6">
    <h1 class="text-2xl font-extrabold text-slate-800 mb-6">Kitoblar boshqaruvi</h1>

    <%c++ if (!flashMsg.empty()) { %>
    <div class="flex items-center gap-2 px-4 py-3 rounded-xl text-sm font-medium mb-5
        <%c++ if (flashType == "success") { %>bg-green-50 border border-green-200 text-green-700<%c++ } else { %>bg-red-50 border border-red-200 text-red-700<%c++ } %>">
        <%c++ if (flashType == "success") { %>✅<%c++ } else { %>⚠️<%c++ } %>
        <%c++ AdminBooks_tmp_stream << flashMsg; %>
    </div>
    <%c++ } %>

    <div class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
        <div class="px-5 py-4 border-b border-slate-100 flex items-center justify-between">
            <span class="font-bold text-slate-800">Jami: <%c++ AdminBooks_tmp_stream << books.size(); %> ta kitob</span>
            <a href="/admin/books/yangi"
               class="flex items-center gap-2 text-xs font-bold bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-xl transition">
                <i class="fas fa-plus"></i> Kitob qo'shish
            </a>
        </div>
        <div class="overflow-x-auto">
            <table class="w-full">
                <thead class="bg-slate-50 border-b border-slate-200">
                    <tr>
                        <th class="px-5 py-3 text-left text-xs font-bold text-slate-500 uppercase">#</th>
                        <th class="px-5 py-3 text-left text-xs font-bold text-slate-500 uppercase">Nomi</th>
                        <th class="px-5 py-3 text-left text-xs font-bold text-slate-500 uppercase">Muallif</th>
                        <th class="px-5 py-3 text-left text-xs font-bold text-slate-500 uppercase">Kutubxona</th>
                        <th class="px-5 py-3 text-left text-xs font-bold text-slate-500 uppercase">Holat</th>
                        <th class="px-5 py-3 text-left text-xs font-bold text-slate-500 uppercase">Amallar</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    <%c++ int i = 1; for (auto& b : books) {
                        bool avail = (getOr(b, "is_available", "True") == "True");
                        auto bid = getOr(b, "id");
                    %>
                    <tr class="hover:bg-slate-50 transition">
                        <td class="px-5 py-3 text-xs text-slate-400 font-mono"><%c++ AdminBooks_tmp_stream << i++; %></td>
                        <td class="px-5 py-3">
                            <div class="flex items-center gap-3">
                                <%c++ auto cover = getOr(b, "cover_image"); if (!cover.empty()) { %>
                                <img src="<%c++ AdminBooks_tmp_stream << cover; %>" alt=""
                                     class="w-8 h-10 rounded object-cover flex-shrink-0 border border-slate-200">
                                <%c++ } else { %>
                                <div class="w-8 h-10 rounded bg-slate-100 flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-book text-slate-300 text-xs"></i>
                                </div>
                                <%c++ } %>
                                <div>
                                    <a href="/kitob/<%c++ AdminBooks_tmp_stream << bid; %>"
                                       class="font-semibold text-sm text-slate-800 hover:text-blue-600 transition">
                                        <%c++ AdminBooks_tmp_stream << getOr(b, "title", "—"); %>
                                    </a>
                                    <%c++ auto ebk = getOr(b, "ebook_file"); if (!ebk.empty()) { %>
                                    <span class="ml-1 text-[10px] bg-purple-100 text-purple-600 px-1.5 py-0.5 rounded font-bold">PDF</span>
                                    <%c++ } %>
                                </div>
                            </div>
                        </td>
                        <td class="px-5 py-3 text-sm text-slate-500"><%c++ AdminBooks_tmp_stream << getOr(b, "author_name", "—"); %></td>
                        <td class="px-5 py-3 text-sm text-slate-500"><%c++ AdminBooks_tmp_stream << getOr(b, "library_name", "—"); %></td>
                        <td class="px-5 py-3">
                            <span class="text-xs font-bold px-2.5 py-1 rounded-full
                                <%c++ if (avail) { %>bg-green-100 text-green-700<%c++ } else { %>bg-yellow-100 text-yellow-700<%c++ } %>">
                                <%c++ if (avail) { %>✅ Mavjud<%c++ } else { %>🔒 Band<%c++ } %>
                            </span>
                        </td>
                        <td class="px-5 py-3">
                            <div class="flex items-center gap-2">
                                <a href="/admin/books/<%c++ AdminBooks_tmp_stream << bid; %>/tahrir"
                                   class="text-xs font-bold text-blue-500 border border-blue-200 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                                    <i class="fas fa-edit mr-1"></i>Tahrir
                                </a>
                                <form method="POST" action="/admin/books/<%c++ AdminBooks_tmp_stream << bid; %>/ochir"
                                      onsubmit="return confirm('Kitobni o\'chirasizmi?')" class="inline">
                                    <input type="hidden" name="csrf_token" value="<%c++ AdminBooks_tmp_stream << csrf; %>">
                                    <button type="submit"
                                        class="text-xs font-bold text-red-500 border border-red-200 px-3 py-1.5 rounded-lg hover:bg-red-50 transition">
                                        <i class="fas fa-trash mr-1"></i>O'chirish
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    <%c++ } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
</body>
</html>
