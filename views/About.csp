<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TATU Kutubxona | Loyiha haqida</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style>
        body { font-family: 'Inter', sans-serif; background: #f1f5f9; }
        .tech-tag { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; font-size: 12px; font-weight: 600; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    auto loggedIn = @@.get<bool>("is_logged_in");
    auto& name    = @@.get<std::string>("reader_name");
%>

<nav class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
    <div class="max-w-4xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
            <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center text-white font-black text-xs">T</div>
            <span class="font-bold text-slate-800">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <a href="/" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                <i class="fas fa-book mr-1"></i>Kitoblar
            </a>
            <a href="/kutubxonalar" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                <i class="fas fa-map-marker-alt mr-1"></i>Kutubxonalar
            </a>
            <%c++ if (loggedIn) { %>
            <a href="/kabinet" class="text-xs font-semibold text-blue-600 border border-blue-200 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                <i class="fas fa-user mr-1"></i><%c++ About_tmp_stream << name; %>
            </a>
            <%c++ } else { %>
            <a href="/kirish" class="text-xs font-semibold bg-blue-600 text-white px-4 py-1.5 rounded-lg hover:bg-blue-700 transition">Kirish</a>
            <%c++ } %>
        </div>
    </div>
</nav>

<main class="max-w-4xl mx-auto px-4 py-12 flex-grow w-full">

    <!-- Hero -->
    <div class="text-center mb-12">
        <div class="w-20 h-20 bg-blue-600 rounded-2xl flex items-center justify-center text-white font-black text-3xl shadow-lg mx-auto mb-5">T</div>
        <h1 class="text-3xl font-extrabold text-slate-800 mb-3">TATU Kutubxona</h1>
        <p class="text-slate-500 max-w-xl mx-auto text-base leading-relaxed">
            TATU talabalariga mo'ljallangan zamonaviy raqamli kutubxona tizimi — kitoblarni bron qilish,
            e-kitoblarni o'qish va kutubxona xizmatlaridan foydalanish uchun qulay platforma.
        </p>
    </div>

    <!-- Xususiyatlar -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-12">
        <%c++ struct Feature { const char* icon; const char* color; const char* bg; const char* title; const char* desc; };
        Feature features[] = {
            {"fas fa-book","text-blue-600","bg-blue-50","Kitoblar katalogi","Qidiruv, filtr va saralash imkoniyatlari bilan"},
            {"fas fa-bookmark","text-violet-600","bg-violet-50","Online bron qilish","Kutubxonaga kelmasdan kitob band qiling"},
            {"fas fa-mobile-alt","text-emerald-600","bg-emerald-50","E-kitoblar","PDF formatda kitoblarni bevosita o'qing"},
            {"fas fa-id-card","text-amber-600","bg-amber-50","Ruxsatnoma kartasi","Har bir kutubxona uchun alohida karta"},
            {"fas fa-map-marker-alt","text-red-600","bg-red-50","Kutubxona xaritasi","Joylashuv va masofani ko'ring"},
            {"fas fa-star","text-yellow-500","bg-yellow-50","Reyting va sharhlar","Kitoblarni baholang va fikr qoldiring"}
        };
        for (const auto& f : features) { %>
        <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-5">
            <div class="w-10 h-10 <%c++ About_tmp_stream << f.bg; %> rounded-xl flex items-center justify-center mb-3">
                <i class="<%c++ About_tmp_stream << f.icon; %> <%c++ About_tmp_stream << f.color; %>"></i>
            </div>
            <h3 class="font-bold text-slate-800 text-sm mb-1"><%c++ About_tmp_stream << f.title; %></h3>
            <p class="text-xs text-slate-400"><%c++ About_tmp_stream << f.desc; %></p>
        </div>
        <%c++ } %>
    </div>

    <!-- Texnologiyalar -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 mb-8">
        <h2 class="font-bold text-slate-800 mb-4"><i class="fas fa-code text-blue-500 mr-2"></i>Texnologiyalar</h2>
        <div class="flex flex-wrap gap-2">
            <span class="tech-tag bg-blue-50 text-blue-700 border border-blue-200"><i class="fab fa-python"></i>Django REST</span>
            <span class="tech-tag bg-slate-100 text-slate-700 border border-slate-200"><i class="fas fa-server"></i>Drogon C++</span>
            <span class="tech-tag bg-teal-50 text-teal-700 border border-teal-200"><i class="fas fa-wind"></i>TailwindCSS</span>
            <span class="tech-tag bg-orange-50 text-orange-700 border border-orange-200"><i class="fas fa-database"></i>SQLite</span>
            <span class="tech-tag bg-green-50 text-green-700 border border-green-200"><i class="fas fa-map"></i>Leaflet.js</span>
            <span class="tech-tag bg-purple-50 text-purple-700 border border-purple-200"><i class="fas fa-desktop"></i>WinForms C++/CLI</span>
        </div>
    </div>

    <!-- Arxitektura -->
    <div class="bg-white rounded-2xl border border-slate-100 shadow-sm p-6 mb-8">
        <h2 class="font-bold text-slate-800 mb-4"><i class="fas fa-sitemap text-blue-500 mr-2"></i>Loyiha arxitekturasi</h2>
        <div class="grid sm:grid-cols-3 gap-4 text-center">
            <div class="bg-slate-50 rounded-xl p-4 border border-slate-200">
                <i class="fas fa-desktop text-2xl text-blue-600 mb-2 block"></i>
                <p class="text-xs font-bold text-slate-700">Desktop ilova</p>
                <p class="text-xs text-slate-400 mt-0.5">C++/CLI WinForms</p>
            </div>
            <div class="flex items-center justify-center">
                <div class="text-center">
                    <i class="fas fa-exchange-alt text-slate-400 text-xl mb-1 block"></i>
                    <p class="text-xs text-slate-400 font-semibold">REST API</p>
                    <p class="text-xs text-slate-300">JSON / HTTP</p>
                </div>
            </div>
            <div class="bg-slate-50 rounded-xl p-4 border border-slate-200">
                <i class="fas fa-server text-2xl text-violet-600 mb-2 block"></i>
                <p class="text-xs font-bold text-slate-700">Django Backend</p>
                <p class="text-xs text-slate-400 mt-0.5">Python + SQLite</p>
            </div>
        </div>
        <div class="flex justify-center mt-4">
            <div class="bg-slate-50 rounded-xl p-4 border border-slate-200 text-center">
                <i class="fas fa-globe text-2xl text-emerald-600 mb-2 block"></i>
                <p class="text-xs font-bold text-slate-700">Web ilova</p>
                <p class="text-xs text-slate-400 mt-0.5">Drogon C++ + CSP views</p>
            </div>
        </div>
    </div>

    <!-- Versiya -->
    <div class="text-center text-xs text-slate-400">
        <p>Versiya 1.0.0 • 2026 yil</p>
        <p class="mt-1">TATU — Toshkent Axborot Texnologiyalari Universiteti</p>
    </div>
</main>

<footer class="py-5 text-center text-xs text-slate-300 border-t border-slate-100 mt-auto">
    © 2026 TATU Kutubxona
</footer>
</body>
</html>
