<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <%c++ Register_tmp_stream << PREMIUM_HEAD; %>
    <title>TATU Kutubxona | Ro'yxat</title>
</head>
<body>
    <%c++
        auto& csrf     = @@.get<std::string>("csrf_token");
        auto& errorMsg = @@.get<std::string>("error_msg");
    %>

    <div class="auth-wrapper">
        <div class="auth-card" style="max-width:480px">
            <a href="/" class="flex items-center justify-center gap-2.5 mb-8">
                <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center text-white font-black text-lg shadow-lg">T</div>
                <span class="text-xl font-extrabold text-slate-800 tracking-tight">TATU Kutubxona</span>
            </a>

            <div class="text-center mb-7">
                <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-500 flex items-center justify-center text-white text-xl shadow-lg shadow-emerald-500/25">
                    <i class="fas fa-user-plus"></i>
                </div>
                <h1 class="text-xl font-extrabold text-slate-800">Ro'yxatdan o'tish</h1>
                <p class="text-xs text-slate-400 mt-1 uppercase tracking-[0.15em] font-semibold">Yangi o'quvchi hisobi</p>
            </div>

            <%c++ if (!errorMsg.empty()) { %>
            <div class="toast-premium toast-error mb-5">
                <i class="fas fa-exclamation-circle"></i>
                <%c++ Register_tmp_stream << errorMsg; %>
            </div>
            <%c++ } %>

            <form action="/royxat" method="POST" class="space-y-4">
                <input type="hidden" name="csrf_token" value="<%c++ Register_tmp_stream << csrf; %>">

                <div class="field-float">
                    <input type="text" name="fullname" id="fullname" placeholder=" " required>
                    <label for="fullname"><i class="fas fa-user mr-1.5 text-xs"></i>To'liq ism</label>
                </div>

                <div class="field-float">
                    <input type="text" name="phone" id="phone" placeholder=" " required>
                    <label for="phone"><i class="fas fa-phone mr-1.5 text-xs"></i>Telefon raqam</label>
                </div>

                <div class="field-float">
                    <input type="email" name="email" id="email" placeholder=" ">
                    <label for="email"><i class="fas fa-envelope mr-1.5 text-xs"></i>Email <span class="text-slate-300 font-normal">(ixtiyoriy)</span></label>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div class="field-float">
                        <input type="password" name="password" id="pwd1" placeholder=" " required>
                        <label for="pwd1"><i class="fas fa-key mr-1.5 text-xs"></i>Parol</label>
                    </div>
                    <div class="field-float">
                        <input type="password" name="password2" id="pwd2" placeholder=" " required>
                        <label for="pwd2"><i class="fas fa-check mr-1.5 text-xs"></i>Tasdiqlang</label>
                    </div>
                </div>

                <div class="bg-blue-50/80 border border-blue-200/60 rounded-xl px-4 py-3 text-xs text-blue-700 space-y-1">
                    <p><i class="fas fa-info-circle mr-1"></i>Ro'yxatdan o'tgach, <strong>profilingizda</strong> kerakli kutubxona uchun karta rasmini yuklang.</p>
                    <p class="text-blue-500">Har bir kutubxona uchun alohida karta tasdiqlanadi.</p>
                </div>

                <button type="submit" class="btn-prem btn-prem-success w-full py-3.5 text-sm">
                    <i class="fas fa-user-check"></i> Ro'yxatdan o'tish
                </button>
            </form>

            <div class="mt-7 pt-5 border-t border-slate-100 text-center text-xs text-slate-400">
                Hisobingiz bormi?
                <a href="/kirish" class="link-premium ml-1">Kiring</a>
            </div>
        </div>
    </div>
</body>
</html>
