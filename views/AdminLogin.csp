<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TATU | Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background: #0f172a; }
        .input-field { background: #1e293b; border: 1.5px solid #334155; border-radius: 8px; padding: 11px 16px; width: 100%; outline: none; transition: all .2s; font-size: 14px; color: #e2e8f0; }
        .input-field:focus { border-color: #3b82f6; background: #1e293b; }
        .input-field::placeholder { color: #475569; }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center justify-center p-6">
    <%c++
        auto& csrf     = @@.get<std::string>("csrf_token");
        auto& errorMsg = @@.get<std::string>("error_msg");
    %>

    <div class="w-full max-w-sm">
        <div class="flex items-center justify-center gap-2 mb-8">
            <div class="w-10 h-10 bg-blue-600 rounded-xl flex items-center justify-center text-white font-black text-lg shadow-lg">T</div>
            <div>
                <p class="text-white font-bold text-lg leading-none">TATU Kutubxona</p>
                <p class="text-slate-400 text-xs">Admin panel</p>
            </div>
        </div>

        <div class="bg-slate-800 rounded-2xl border border-slate-700 p-8">
            <h1 class="text-white font-bold text-xl text-center mb-1">Administrator</h1>
            <p class="text-slate-400 text-xs text-center uppercase tracking-widest mb-6">Maxfiy kirish</p>

            <%c++ if (!errorMsg.empty()) { %>
            <div class="bg-red-500/10 border border-red-500/30 text-red-400 text-sm px-4 py-3 rounded-lg mb-5 text-center">
                <%c++ AdminLogin_tmp_stream << errorMsg; %>
            </div>
            <%c++ } %>

            <form action="/admin" method="POST" class="space-y-4">
                <input type="hidden" name="csrf_token" value="<%c++ AdminLogin_tmp_stream << csrf; %>">
                <div>
                    <label class="text-xs font-semibold text-slate-400 uppercase tracking-wide block mb-1.5">Admin token</label>
                    <input type="password" name="admin_token" placeholder="••••••••" required class="input-field">
                </div>
                <button type="submit"
                    class="w-full py-3 bg-blue-600 text-white font-bold text-sm rounded-lg hover:bg-blue-700 transition mt-2">
                    Kirish
                </button>
            </form>
        </div>

        <p class="text-center mt-6 text-xs text-slate-500">
            <a href="/" class="hover:text-slate-300 transition">← Asosiy saytga qaytish</a>
        </p>
    </div>
</body>
</html>
