<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <%c++ Login_tmp_stream << PREMIUM_HEAD; %>
    <title>TATU Kutubxona | Kirish</title>
</head>
<body>
    <%c++
        auto& csrf     = @@.get<std::string>("csrf_token");
        auto& errorMsg = @@.get<std::string>("error_msg");
        auto& nextUrl  = @@.get<std::string>("next_url");
    %>

    <div class="auth-wrapper">
        <div class="auth-card">
            <a href="/" class="flex items-center justify-center gap-2.5 mb-8">
                <div class="w-10 h-10 bg-gradient-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center text-white font-black text-lg shadow-lg">T</div>
                <span class="text-xl font-extrabold text-slate-800 tracking-tight">TATU Kutubxona</span>
            </a>

            <div class="text-center mb-7">
                <div class="w-14 h-14 mx-auto mb-3 rounded-2xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center text-white text-xl shadow-lg shadow-blue-500/25">
                    <i class="fas fa-lock"></i>
                </div>
                <h1 class="text-xl font-extrabold text-slate-800">Tizimga kirish</h1>
                <p class="text-xs text-slate-400 mt-1 uppercase tracking-[0.15em] font-semibold">O'quvchi hisobi</p>
            </div>

            <%c++ if (!errorMsg.empty()) { %>
            <div class="toast-premium toast-error mb-5">
                <i class="fas fa-exclamation-circle"></i>
                <%c++ Login_tmp_stream << errorMsg; %>
            </div>
            <%c++ } %>

            <form action="/kirish" method="POST" class="space-y-5">
                <input type="hidden" name="csrf_token" value="<%c++ Login_tmp_stream << csrf; %>">
                <input type="hidden" name="next" value="<%c++ Login_tmp_stream << nextUrl; %>">

                <div class="field-float">
                    <input type="tel" name="phone" id="phone" placeholder=" " required autocomplete="tel">
                    <label for="phone"><i class="fas fa-phone mr-1.5 text-xs"></i>Telefon raqam</label>
                </div>

                <div class="field-float">
                    <input type="password" name="password" id="pwd" placeholder=" " required autocomplete="current-password">
                    <label for="pwd"><i class="fas fa-key mr-1.5 text-xs"></i>Parol</label>
                    <button type="button" onclick="togglePwd()"
                        class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-blue-600 text-sm transition z-10" tabindex="-1">
                        <i class="fas fa-eye" id="pwd-icon"></i>
                    </button>
                </div>

                <button type="submit" class="btn-prem btn-prem-primary w-full py-3.5 text-sm mt-1">
                    <i class="fas fa-arrow-right-to-bracket"></i> Kirish
                </button>
            </form>

            <div class="mt-7 pt-5 border-t border-slate-100 text-center text-xs text-slate-400">
                Hisobingiz yo'qmi?
                <a href="/royxat" class="link-premium ml-1">Ro'yxatdan o'ting</a>
            </div>

            <p class="text-center text-xs text-slate-300 mt-4">
                <a href="/admin" class="hover:text-slate-500 transition"><i class="fas fa-shield-halved mr-1"></i>Admin panel</a>
            </p>
        </div>
    </div>

    <script>
    function togglePwd() {
        const p = document.getElementById('pwd');
        const icon = document.getElementById('pwd-icon');
        if (p.type === 'password') { p.type = 'text'; icon.className = 'fas fa-eye-slash'; }
        else { p.type = 'password'; icon.className = 'fas fa-eye'; }
    }
    </script>
</body>
</html>
