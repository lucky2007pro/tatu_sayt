<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin | Analitika</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style> body { font-family: 'Inter', sans-serif; background: #0f172a; color: #e2e8f0; } </style>
</head>
<body class="min-h-screen" style="background:#0f172a;color:#e2e8f0">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& popular   = @@.get<RowList>("popular");
    auto tBooks     = @@.get<std::string>("total_books");
    auto tReaders   = @@.get<std::string>("total_readers");
    auto tReservs   = @@.get<std::string>("total_reservations");
    auto tIssues    = @@.get<std::string>("total_issues");
    auto tLibs      = @@.get<std::string>("total_libraries");
%>

<nav class="bg-slate-900 text-white sticky top-0 z-50 shadow-lg border-b border-slate-700">
    <div class="max-w-7xl mx-auto px-4 h-14 flex items-center justify-between">
        <div class="flex items-center gap-3">
            <div class="w-7 h-7 bg-blue-500 rounded-lg flex items-center justify-center font-black text-xs">T</div>
            <span class="font-bold text-sm">TATU Admin</span>
            <span class="text-slate-500 text-xs">|</span>
            <span class="text-slate-300 text-xs font-medium">Analitika</span>
        </div>
        <div class="flex items-center gap-1 text-xs">
            <a href="/admin/dashboard" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Panel</a>
            <a href="/admin/readers" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">O'quvchilar</a>
            <a href="/admin/books" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Kitoblar</a>
            <a href="/admin/bronlar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Bronlar</a>
            <a href="/admin/berishlar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Berishlar</a>
            <a href="/admin/kartalar" class="px-3 py-1.5 rounded-lg hover:bg-slate-700 text-slate-300 transition">Kartalar</a>
            <a href="/admin/analitika" class="px-3 py-1.5 rounded-lg bg-slate-700 text-white transition"><i class="fas fa-chart-bar mr-1"></i>Analitika</a>
            <a href="/admin/chiqish" class="ml-2 px-3 py-1.5 rounded-lg bg-red-600 hover:bg-red-700 text-white transition"><i class="fas fa-sign-out-alt"></i></a>
        </div>
    </div>
</nav>

<div class="flex flex-col min-h-screen">
    <header class="bg-slate-800 border-b border-slate-700 px-6 py-4 flex items-center justify-between">
        <h1 class="text-lg font-bold text-slate-100 flex items-center gap-2">
            <i class="fas fa-chart-bar text-blue-400"></i> Analitika va Hisobotlar
        </h1>
        <div class="flex items-center gap-2">
            <a href="/admin/csv/books" class="flex items-center gap-1.5 text-xs bg-green-700 hover:bg-green-600 text-white px-3 py-1.5 rounded-lg transition">
                <i class="fas fa-file-csv"></i> Kitoblar CSV
            </a>
            <a href="/admin/csv/readers" class="flex items-center gap-1.5 text-xs bg-green-700 hover:bg-green-600 text-white px-3 py-1.5 rounded-lg transition">
                <i class="fas fa-file-csv"></i> O'quvchilar CSV
            </a>
            <a href="/admin/csv/reservations" class="flex items-center gap-1.5 text-xs bg-green-700 hover:bg-green-600 text-white px-3 py-1.5 rounded-lg transition">
                <i class="fas fa-file-csv"></i> Bronlar CSV
            </a>
            <a href="/admin/csv/issues" class="flex items-center gap-1.5 text-xs bg-green-700 hover:bg-green-600 text-white px-3 py-1.5 rounded-lg transition">
                <i class="fas fa-file-csv"></i> Berishlar CSV
            </a>
        </div>
    </header>

    <main class="flex-1 p-6">

        <!-- Stat kartalar -->
        <div class="grid grid-cols-2 md:grid-cols-5 gap-4 mb-8">
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 text-center">
                <i class="fas fa-book text-blue-400 text-2xl mb-2 block"></i>
                <div class="text-3xl font-black text-white"><%c++ AdminAnalytics_tmp_stream << tBooks; %></div>
                <div class="text-slate-400 text-xs mt-1">Kitoblar</div>
            </div>
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 text-center">
                <i class="fas fa-users text-purple-400 text-2xl mb-2 block"></i>
                <div class="text-3xl font-black text-white"><%c++ AdminAnalytics_tmp_stream << tReaders; %></div>
                <div class="text-slate-400 text-xs mt-1">O'quvchilar</div>
            </div>
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 text-center">
                <i class="fas fa-bookmark text-yellow-400 text-2xl mb-2 block"></i>
                <div class="text-3xl font-black text-white"><%c++ AdminAnalytics_tmp_stream << tReservs; %></div>
                <div class="text-slate-400 text-xs mt-1">Bronlar</div>
            </div>
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 text-center">
                <i class="fas fa-book-open text-green-400 text-2xl mb-2 block"></i>
                <div class="text-3xl font-black text-white"><%c++ AdminAnalytics_tmp_stream << tIssues; %></div>
                <div class="text-slate-400 text-xs mt-1">Berishlar</div>
            </div>
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-4 text-center">
                <i class="fas fa-building text-cyan-400 text-2xl mb-2 block"></i>
                <div class="text-3xl font-black text-white"><%c++ AdminAnalytics_tmp_stream << tLibs; %></div>
                <div class="text-slate-400 text-xs mt-1">Kutubxonalar</div>
            </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-6">
            <!-- Ommabop kitoblar grafik -->
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5">
                <h3 class="font-bold text-slate-100 mb-4 flex items-center gap-2">
                    <i class="fas fa-fire text-orange-400"></i> Eng ommabop kitoblar (ko'rishlar)
                </h3>
                <canvas id="popularChart" height="260"></canvas>
            </div>

            <!-- Reyting grafik -->
            <div class="bg-slate-800 border border-slate-700 rounded-2xl p-5">
                <h3 class="font-bold text-slate-100 mb-4 flex items-center gap-2">
                    <i class="fas fa-star text-yellow-400"></i> Eng yuqori reytingli kitoblar
                </h3>
                <canvas id="ratingChart" height="260"></canvas>
            </div>
        </div>

        <!-- Jadval -->
        <div class="bg-slate-800 border border-slate-700 rounded-2xl overflow-hidden">
            <div class="px-5 py-4 border-b border-slate-700 flex items-center justify-between">
                <h3 class="font-bold text-slate-100 flex items-center gap-2">
                    <i class="fas fa-trophy text-yellow-400"></i> Top kitoblar ro'yxati
                </h3>
                <a href="/admin/csv/books" class="text-xs text-green-400 hover:text-green-300 flex items-center gap-1">
                    <i class="fas fa-download"></i> CSV yuklab olish
                </a>
            </div>
            <div class="overflow-x-auto">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="border-b border-slate-700 text-slate-400">
                            <th class="px-4 py-3 text-left font-semibold">#</th>
                            <th class="px-4 py-3 text-left font-semibold">Kitob</th>
                            <th class="px-4 py-3 text-left font-semibold">Muallif</th>
                            <th class="px-4 py-3 text-left font-semibold">Kutubxona</th>
                            <th class="px-4 py-3 text-right font-semibold">Reyting</th>
                            <th class="px-4 py-3 text-right font-semibold">Ko'rishlar</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-700">
                    <%c++ int rank = 1;
                    for (auto& p : popular) {
                        auto title   = getOr(p, "title");
                        auto author  = getOr(p, "author_name");
                        auto lib     = getOr(p, "library_name");
                        auto rating  = getOr(p, "average_rating", "—");
                        auto views   = getOr(p, "view_count", "0");
                    %>
                        <tr class="hover:bg-slate-700/50 transition">
                            <td class="px-4 py-3 text-slate-400 font-bold">
                                <%c++ if (rank == 1) { %>🥇<%c++ } else if (rank == 2) { %>🥈<%c++ } else if (rank == 3) { %>🥉<%c++ } else { AdminAnalytics_tmp_stream << rank; } %>
                            </td>
                            <td class="px-4 py-3 font-semibold text-slate-100 max-w-48 truncate"><%c++ AdminAnalytics_tmp_stream << title; %></td>
                            <td class="px-4 py-3 text-slate-300"><%c++ AdminAnalytics_tmp_stream << author; %></td>
                            <td class="px-4 py-3 text-slate-400 text-xs"><%c++ AdminAnalytics_tmp_stream << lib; %></td>
                            <td class="px-4 py-3 text-right">
                                <span class="text-yellow-400 font-bold">★ <%c++ AdminAnalytics_tmp_stream << rating; %></span>
                            </td>
                            <td class="px-4 py-3 text-right text-slate-300 font-mono"><%c++ AdminAnalytics_tmp_stream << views; %></td>
                        </tr>
                    <%c++ rank++; } %>
                    </tbody>
                </table>
            </div>
        </div>
    </main>
</div>

<script>
// Chart.js ma'lumotlari
const popularLabels = [
<%c++ bool fc = true; for (auto& p : popular) {
    auto title = getOr(p, "title");
    if (title.size() > 18) title = title.substr(0, 18) + "...";
    if (!fc) AdminAnalytics_tmp_stream << ",";
    AdminAnalytics_tmp_stream << "\"" << title << "\"";
    fc = false;
} %>
];
const popularViews = [
<%c++ fc = true; for (auto& p : popular) {
    auto v = getOr(p, "view_count", "0");
    if (!fc) AdminAnalytics_tmp_stream << ",";
    AdminAnalytics_tmp_stream << v;
    fc = false;
} %>
];
const popularRatings = [
<%c++ fc = true; for (auto& p : popular) {
    auto r = getOr(p, "average_rating", "0");
    if (!fc) AdminAnalytics_tmp_stream << ",";
    AdminAnalytics_tmp_stream << r;
    fc = false;
} %>
];

const palette = ['#3b82f6','#8b5cf6','#10b981','#f59e0b','#ef4444','#06b6d4','#ec4899','#84cc16'];

new Chart(document.getElementById('popularChart'), {
    type: 'bar',
    data: {
        labels: popularLabels,
        datasets: [{
            label: "Ko'rishlar",
            data: popularViews,
            backgroundColor: palette,
            borderRadius: 6,
        }]
    },
    options: {
        plugins: { legend: { display: false } },
        scales: {
            x: { ticks: { color: '#94a3b8', font: { size: 10 } }, grid: { color: '#1e293b' } },
            y: { ticks: { color: '#94a3b8' }, grid: { color: '#1e293b' } }
        }
    }
});

new Chart(document.getElementById('ratingChart'), {
    type: 'bar',
    data: {
        labels: popularLabels,
        datasets: [{
            label: 'Reyting (1-5)',
            data: popularRatings,
            backgroundColor: '#f59e0b',
            borderRadius: 6,
        }]
    },
    options: {
        plugins: { legend: { display: false } },
        scales: {
            x: { ticks: { color: '#94a3b8', font: { size: 10 } }, grid: { color: '#1e293b' } },
            y: { min: 0, max: 5, ticks: { color: '#94a3b8' }, grid: { color: '#1e293b' } }
        }
    }
});
</script>

</body>
</html>
