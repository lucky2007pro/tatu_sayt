<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <%c++ Profile_tmp_stream << PREMIUM_HEAD; %>
    <title>TATU Kutubxona | Profilim</title>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& reader    = @@.get<Row>("reader");
    auto& cards     = @@.get<RowList>("cards");
    auto& libraries = @@.get<RowList>("libraries");
    auto  approved  = @@.get<bool>("reader_approved");
    auto& csrf      = @@.get<std::string>("csrf_token");
    auto& flashMsg  = @@.get<std::string>("flash_msg");
    auto& flashType = @@.get<std::string>("flash_type");
    std::string readerName = getOr(reader, "fullname", "O'quvchi");
%>

<!-- NAVBAR -->
<nav class="navbar-premium sticky top-0 z-50">
    <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
            <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center text-white font-black text-sm shadow-md">T</div>
            <span class="font-extrabold text-slate-800 tracking-tight">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <a href="/" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-2 rounded-lg hover:bg-blue-50/60 transition"><i class="fas fa-home mr-1"></i>Kitoblar</a>
            <a href="/kabinet" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-2 rounded-lg hover:bg-blue-50/60 transition"><i class="fas fa-bookmark mr-1"></i>Kabinet</a>
            <a href="/chiqish" class="text-xs font-semibold text-red-500 border border-red-200 px-3 py-2 rounded-lg hover:bg-red-50/60 transition"><i class="fas fa-sign-out-alt mr-1"></i>Chiqish</a>
        </div>
    </div>
</nav>

<!-- Flash -->
<%c++ if (!flashMsg.empty()) { %>
<div class="max-w-4xl mx-auto px-4 pt-4">
    <div class="toast-premium <%c++ if (flashType == "success") { %>toast-success<%c++ } else { %>toast-error<%c++ } %>">
        <i class="fas <%c++ if (flashType == "success") { %>fa-check-circle<%c++ } else { %>fa-exclamation-circle<%c++ } %>"></i>
        <%c++ Profile_tmp_stream << flashMsg; %>
    </div>
</div>
<%c++ } %>

<main class="max-w-4xl mx-auto px-4 py-8 flex-grow w-full page-transition">

    <!-- Avatar + Ism -->
    <div class="flex items-center gap-5 mb-8 fade-in-up">
        <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-600 to-blue-700 flex items-center justify-center text-white text-2xl font-black shadow-xl shadow-blue-500/25 ring-4 ring-blue-100">
            <%c++ Profile_tmp_stream << (readerName.empty() ? "?" : std::string(1, readerName[0])); %>
        </div>
        <div>
            <h1 class="text-2xl font-extrabold text-slate-800"><%c++ Profile_tmp_stream << readerName; %></h1>
            <p class="text-sm text-slate-400">Karta ID: <span class="font-mono font-semibold text-slate-600"><%c++ Profile_tmp_stream << getOr(reader, "card_id"); %></span></p>
        </div>
        <%c++ if (!approved) { %>
        <span class="ml-auto pill-premium pill-amber"><i class="fas fa-clock text-xs mr-1"></i>Admin tasdig'i kutilmoqda</span>
        <%c++ } else { %>
        <span class="ml-auto pill-premium pill-emerald"><i class="fas fa-check-circle text-xs mr-1"></i>Faol hisob</span>
        <%c++ } %>
    </div>

    <div class="grid md:grid-cols-2 gap-6">

        <!-- Profil tahrirlash -->
        <div class="card-premium p-6 fade-in-up">
            <div class="flex items-center gap-2.5 mb-5">
                <div class="w-9 h-9 bg-blue-50 rounded-xl flex items-center justify-center"><i class="fas fa-user-edit text-blue-600 text-sm"></i></div>
                <h2 class="font-bold text-slate-800">Profilni tahrirlash</h2>
            </div>
            <form action="/profil/edit" method="POST" class="space-y-4">
                <input type="hidden" name="csrf_token" value="<%c++ Profile_tmp_stream << csrf; %>">
                <div class="field-float">
                    <input type="text" name="fullname" id="fullname" placeholder=" " value="<%c++ Profile_tmp_stream << getOr(reader, "fullname"); %>">
                    <label for="fullname">To'liq ism</label>
                </div>
                <div class="field-float">
                    <input type="text" name="phone" id="phone" placeholder=" " value="<%c++ Profile_tmp_stream << getOr(reader, "phone"); %>">
                    <label for="phone">Telefon</label>
                </div>
                <div class="field-float">
                    <input type="password" name="password" id="password" placeholder=" ">
                    <label for="password">Yangi parol <span class="text-slate-300 font-normal">(ixtiyoriy)</span></label>
                </div>
                <button type="submit" class="btn-prem btn-prem-primary w-full py-3 text-sm">
                    <i class="fas fa-save"></i> Saqlash
                </button>
            </form>
        </div>

        <!-- Karta yuklash -->
        <div class="card-premium p-6 fade-in-up-delay-1">
            <div class="flex items-center gap-2.5 mb-5">
                <div class="w-9 h-9 bg-emerald-50 rounded-xl flex items-center justify-center"><i class="fas fa-id-card text-emerald-600 text-sm"></i></div>
                <h2 class="font-bold text-slate-800">Kutubxona kartasi yuklash</h2>
            </div>
            <p class="text-xs text-slate-400 mb-4">Kitob bron qilish uchun har bir kutubxona uchun alohida ruxsatnoma karta rasmini yuklash kerak.</p>

            <form action="/profil/karta" method="POST" id="cardForm" class="space-y-4">
                <input type="hidden" name="csrf_token" value="<%c++ Profile_tmp_stream << csrf; %>">
                <input type="hidden" name="card_image_base64" id="cardBase64">
                <div>
                    <select name="library_id" required class="select-premium w-full">
                        <option value="">— Kutubxona tanlang —</option>
                        <%c++ for (const auto& lib : libraries) { %>
                        <option value="<%c++ Profile_tmp_stream << getOr(lib, "id"); %>"><%c++ Profile_tmp_stream << getOr(lib, "name"); %></option>
                        <%c++ } %>
                    </select>
                </div>
                <div>
                    <div class="border-2 border-dashed border-slate-200 rounded-xl p-5 text-center hover:border-blue-400 transition cursor-pointer pulse-glow" onclick="document.getElementById('fileInput').click()" style="animation-duration:3s">
                        <i class="fas fa-cloud-upload-alt text-2xl text-slate-300 mb-2 block"></i>
                        <p class="text-xs text-slate-400" id="fileLabel">JPG, PNG • Maksimum 5 MB</p>
                        <input type="file" id="fileInput" accept="image/*" class="hidden" onchange="handleFile(this)">
                    </div>
                    <div id="imgPreview" class="hidden mt-2 rounded-xl overflow-hidden border border-slate-200 shadow-sm">
                        <img id="previewImg" class="w-full max-h-40 object-cover">
                    </div>
                </div>
                <button type="submit" id="uploadBtn" disabled
                        class="btn-prem btn-prem-success w-full py-3 text-sm disabled:opacity-40 disabled:cursor-not-allowed">
                    <i class="fas fa-upload"></i> Yuklash
                </button>
            </form>
        </div>
    </div>

    <!-- Mening kutubxona kartalarim -->
    <div class="mt-6 card-premium p-6 fade-in-up-delay-2">
        <div class="flex items-center gap-2.5 mb-5">
            <div class="w-9 h-9 bg-violet-50 rounded-xl flex items-center justify-center"><i class="fas fa-address-card text-violet-600 text-sm"></i></div>
            <h2 class="font-bold text-slate-800">Mening kutubxona kartalarim</h2>
            <span class="ml-auto pill-premium pill-slate"><%c++ Profile_tmp_stream << cards.size(); %> ta</span>
        </div>

        <%c++ if (cards.empty()) { %>
        <div class="text-center py-10">
            <i class="fas fa-id-card text-4xl text-slate-200 mb-3 block"></i>
            <p class="text-sm text-slate-400">Hali kutubxona kartasi yuklanmagan.</p>
            <p class="text-xs text-slate-300 mt-1">Yuqoridagi formadan karta yuboring.</p>
        </div>
        <%c++ } else { %>
        <div class="grid sm:grid-cols-2 gap-3">
        <%c++ for (const auto& card : cards) {
            bool isApproved = (getOr(card, "is_approved") == "True");
        %>
            <div class="flex items-center gap-3 p-3 rounded-xl border transition hover-lift
                <%c++ if (isApproved) { %>border-green-200 bg-green-50/50<%c++ } else { %>border-amber-200 bg-amber-50/50<%c++ } %>">
                <%c++ std::string img = getOr(card, "card_image");
                      if (!img.empty() && img != "null") { %>
                <img src="<%c++ Profile_tmp_stream << img; %>" class="w-14 h-10 object-cover rounded-lg border border-white shadow-sm flex-shrink-0">
                <%c++ } else { %>
                <div class="w-14 h-10 bg-slate-200 rounded-lg flex items-center justify-center flex-shrink-0"><i class="fas fa-image text-slate-400 text-sm"></i></div>
                <%c++ } %>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-slate-700 truncate"><%c++ Profile_tmp_stream << getOr(card, "library_name"); %></p>
                    <%c++ if (isApproved) { %>
                    <span class="pill-premium pill-emerald">✅ Tasdiqlangan</span>
                    <%c++ } else { %>
                    <span class="pill-premium pill-amber"><i class="fas fa-clock text-xs mr-0.5"></i>Ko'rib chiqilmoqda</span>
                    <%c++ } %>
                </div>
            </div>
        <%c++ } %>
        </div>
        <%c++ } %>
    </div>
</main>

<footer class="footer-premium py-6 px-4 text-center text-xs mt-auto">
    <p>© 2026 TATU Kutubxona</p>
</footer>

<script>
function handleFile(input) {
    const file = input.files[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) { alert("Rasm 5 MB dan katta bo'lmasligi kerak."); return; }
    const reader = new FileReader();
    reader.onload = e => {
        document.getElementById('cardBase64').value = e.target.result;
        document.getElementById('previewImg').src = e.target.result;
        document.getElementById('imgPreview').classList.remove('hidden');
        document.getElementById('fileLabel').textContent = file.name;
        document.getElementById('uploadBtn').disabled = false;
    };
    reader.readAsDataURL(file);
}
</script>
</body>
</html>
