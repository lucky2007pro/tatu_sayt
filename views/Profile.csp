<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TATU Kutubxona | Profilim</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style>
        body { font-family: 'Inter', sans-serif; background: #f1f5f9; }
        .input-field { background: #f8fafc; border: 1.5px solid #e2e8f0; border-radius: 8px; padding: 10px 14px; width: 100%; outline: none; transition: all .2s; font-size: 14px; }
        .input-field:focus { border-color: #2563eb; background: #fff; }
        .card-badge { display: inline-flex; align-items: center; gap: 5px; padding: 3px 10px; border-radius: 999px; font-size: 11px; font-weight: 700; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& reader    = @@.get<Row>("reader");
    auto& cards     = @@.get<RowList>("cards");
    auto& libraries = @@.get<RowList>("libraries");
    auto  approved  = @@.get<bool>("reader_approved");
    auto& csrf      = @@.get<std::string>("csrf_token");
    auto& flashMsg  = @@.get<std::string>("flash_msg");
    auto& flashType = @@.get<std::string>("flash_type");
    std::string readerName = getOr(reader, "fullname", "O'quvchi");
%>

<nav class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
    <div class="max-w-4xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
            <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center text-white font-black text-xs">T</div>
            <span class="font-bold text-slate-800">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <a href="/" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                <i class="fas fa-home mr-1"></i>Kitoblar
            </a>
            <a href="/kabinet" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                <i class="fas fa-bookmark mr-1"></i>Kabinet
            </a>
            <a href="/chiqish" class="text-xs font-semibold text-red-500 border border-red-200 px-3 py-1.5 rounded-lg hover:bg-red-50 transition">
                <i class="fas fa-sign-out-alt mr-1"></i>Chiqish
            </a>
        </div>
    </div>
</nav>

<%c++ if (!flashMsg.empty()) { %>
<div class="max-w-4xl mx-auto px-4 pt-4">
    <div class="flex items-center gap-2 px-4 py-3 rounded-xl text-sm font-medium
        <%c++ if (flashType == "success") { %>bg-green-50 border border-green-200 text-green-700<%c++ } else { %>bg-red-50 border border-red-200 text-red-700<%c++ } %>">
        <i class="fas <%c++ if (flashType == "success") { %>fa-check-circle<%c++ } else { %>fa-exclamation-circle<%c++ } %>"></i>
        <%c++ Profile_tmp_stream << flashMsg; %>
    </div>
</div>
<%c++ } %>

<main class="max-w-4xl mx-auto px-4 py-8 flex-grow w-full">

    <!-- Avatar + Ism -->
    <div class="flex items-center gap-4 mb-8">
        <div class="w-16 h-16 rounded-2xl bg-blue-600 flex items-center justify-center text-white text-2xl font-black shadow-lg">
            <%c++ Profile_tmp_stream << (readerName.empty() ? "?" : std::string(1, readerName[0])); %>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-slate-800"><%c++ Profile_tmp_stream << readerName; %></h1>
            <p class="text-sm text-slate-400">Karta ID: <span class="font-mono font-semibold text-slate-600"><%c++ Profile_tmp_stream << getOr(reader, "card_id"); %></span></p>
        </div>
        <%c++ if (!approved) { %>
        <span class="ml-auto card-badge bg-amber-100 text-amber-700 border border-amber-200">
            <i class="fas fa-clock text-xs"></i> Admin tasdig'i kutilmoqda
        </span>
        <%c++ } else { %>
        <span class="ml-auto card-badge bg-green-100 text-green-700 border border-green-200">
            <i class="fas fa-check-circle text-xs"></i> Faol hisob
        </span>
        <%c++ } %>
    </div>

    <div class="grid md:grid-cols-2 gap-6">

        <!-- ── Profil tahrirlash ── -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
            <div class="flex items-center gap-2 mb-5">
                <div class="w-8 h-8 bg-blue-50 rounded-lg flex items-center justify-center">
                    <i class="fas fa-user-edit text-blue-600 text-sm"></i>
                </div>
                <h2 class="font-bold text-slate-800">Profilni tahrirlash</h2>
            </div>

            <form action="/profil/edit" method="POST" class="space-y-4">
                <input type="hidden" name="csrf_token" value="<%c++ Profile_tmp_stream << csrf; %>">
                <div>
                    <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">To'liq ism</label>
                    <input type="text" name="fullname" value="<%c++ Profile_tmp_stream << getOr(reader, "fullname"); %>"
                           placeholder="Ism Familiya" class="input-field">
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">Telefon</label>
                    <input type="text" name="phone" value="<%c++ Profile_tmp_stream << getOr(reader, "phone"); %>"
                           placeholder="+998901234567" class="input-field">
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">Yangi parol <span class="text-slate-300 font-normal">(ixtiyoriy)</span></label>
                    <input type="password" name="password" placeholder="Bo'sh qoldiring — o'zgarmaydi" class="input-field">
                </div>
                <button type="submit" class="w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-bold py-2.5 rounded-lg transition">
                    <i class="fas fa-save mr-1.5"></i>Saqlash
                </button>
            </form>
        </div>

        <!-- ── Karta yuklash ── -->
        <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
            <div class="flex items-center gap-2 mb-5">
                <div class="w-8 h-8 bg-emerald-50 rounded-lg flex items-center justify-center">
                    <i class="fas fa-id-card text-emerald-600 text-sm"></i>
                </div>
                <h2 class="font-bold text-slate-800">Kutubxona kartasi yuklash</h2>
            </div>
            <p class="text-xs text-slate-400 mb-4">Kitob bron qilish uchun har bir kutubxona uchun alohida ruxsatnoma karta rasmini yuklash kerak.</p>

            <form action="/profil/karta" method="POST" id="cardForm" class="space-y-4">
                <input type="hidden" name="csrf_token" value="<%c++ Profile_tmp_stream << csrf; %>">
                <input type="hidden" name="card_image_base64" id="cardBase64">
                <div>
                    <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">Kutubxona</label>
                    <select name="library_id" required class="input-field">
                        <option value="">— Kutubxona tanlang —</option>
                        <%c++ for (const auto& lib : libraries) { %>
                        <option value="<%c++ Profile_tmp_stream << getOr(lib, "id"); %>">
                            <%c++ Profile_tmp_stream << getOr(lib, "name"); %>
                        </option>
                        <%c++ } %>
                    </select>
                </div>
                <div>
                    <label class="text-xs font-semibold text-slate-500 uppercase tracking-wide block mb-1.5">Karta rasmi</label>
                    <div class="border-2 border-dashed border-slate-200 rounded-xl p-4 text-center hover:border-blue-400 transition cursor-pointer" onclick="document.getElementById('fileInput').click()">
                        <i class="fas fa-cloud-upload-alt text-2xl text-slate-300 mb-2 block"></i>
                        <p class="text-xs text-slate-400" id="fileLabel">JPG, PNG • Maksimum 5 MB</p>
                        <input type="file" id="fileInput" accept="image/*" class="hidden" onchange="handleFile(this)">
                    </div>
                    <div id="imgPreview" class="hidden mt-2 rounded-lg overflow-hidden border border-slate-200">
                        <img id="previewImg" class="w-full max-h-40 object-cover">
                    </div>
                </div>
                <button type="submit" id="uploadBtn" disabled
                        class="w-full bg-emerald-600 hover:bg-emerald-700 disabled:bg-slate-200 disabled:text-slate-400 disabled:cursor-not-allowed text-white text-sm font-bold py-2.5 rounded-lg transition">
                    <i class="fas fa-upload mr-1.5"></i>Yuklash
                </button>
            </form>
        </div>
    </div>

    <!-- ── Mening kutubxona kartalarim ── -->
    <div class="mt-6 bg-white rounded-2xl shadow-sm border border-slate-100 p-6">
        <div class="flex items-center gap-2 mb-5">
            <div class="w-8 h-8 bg-violet-50 rounded-lg flex items-center justify-center">
                <i class="fas fa-address-card text-violet-600 text-sm"></i>
            </div>
            <h2 class="font-bold text-slate-800">Mening kutubxona kartalarim</h2>
            <span class="ml-auto text-xs font-bold text-slate-400"><%c++ Profile_tmp_stream << cards.size(); %> ta</span>
        </div>

        <%c++ if (cards.empty()) { %>
        <div class="text-center py-10">
            <i class="fas fa-id-card text-4xl text-slate-200 mb-3 block"></i>
            <p class="text-sm text-slate-400">Hali kutubxona kartasi yuklanmagan.</p>
            <p class="text-xs text-slate-300 mt-1">Yuqoridagi formdan karta yuboring.</p>
        </div>
        <%c++ } else { %>
        <div class="grid sm:grid-cols-2 gap-3">
        <%c++ for (const auto& card : cards) {
            bool isApproved = (getOr(card, "is_approved") == "True");
        %>
            <div class="flex items-center gap-3 p-3 rounded-xl border <%c++ if (isApproved) { %>border-green-200 bg-green-50<%c++ } else { %>border-amber-200 bg-amber-50<%c++ } %>">
                <%c++ std::string img = getOr(card, "card_image");
                      if (!img.empty() && img != "null") { %>
                <img src="<%c++ Profile_tmp_stream << img; %>" class="w-14 h-10 object-cover rounded-lg border border-white shadow-sm flex-shrink-0">
                <%c++ } else { %>
                <div class="w-14 h-10 bg-slate-200 rounded-lg flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-image text-slate-400 text-sm"></i>
                </div>
                <%c++ } %>
                <div class="flex-1 min-w-0">
                    <p class="text-sm font-semibold text-slate-700 truncate"><%c++ Profile_tmp_stream << getOr(card, "library_name"); %></p>
                    <%c++ if (isApproved) { %>
                    <span class="card-badge bg-green-100 text-green-700"><i class="fas fa-check-circle text-xs"></i> Tasdiqlangan</span>
                    <%c++ } else { %>
                    <span class="card-badge bg-amber-100 text-amber-700"><i class="fas fa-clock text-xs"></i> Ko'rib chiqilmoqda</span>
                    <%c++ } %>
                </div>
            </div>
        <%c++ } %>
        </div>
        <%c++ } %>
    </div>

</main>

<footer class="py-5 text-center text-xs text-slate-300 border-t border-slate-100 mt-auto">
    © 2026 TATU Kutubxona
</footer>

<script>
function handleFile(input) {
    const file = input.files[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) {
        alert("Rasm 5 MB dan katta bo'lmasligi kerak.");
        return;
    }
    const reader = new FileReader();
    reader.onload = e => {
        document.getElementById('cardBase64').value = e.target.result;
        document.getElementById('previewImg').src = e.target.result;
        document.getElementById('imgPreview').classList.remove('hidden');
        document.getElementById('fileLabel').textContent = file.name;
        document.getElementById('uploadBtn').disabled = false;
    };
    reader.readAsDataURL(file);
}
</script>
</body>
</html>
