<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TATU Kutubxona | Kutubxonalar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <style>
        body { font-family: 'Inter', sans-serif; background: #f1f5f9; }
        #map { height: 380px; border-radius: 16px; z-index: 0; }
        .lib-card:hover { transform: translateY(-2px); box-shadow: 0 8px 20px -4px rgba(37,99,235,.12); }
        .lib-card { transition: all .2s; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& libraries = @@.get<RowList>("libraries");
    auto  loggedIn  = @@.get<bool>("is_logged_in");
    auto& name      = @@.get<std::string>("reader_name");
%>

<nav class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
            <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center text-white font-black text-xs">T</div>
            <span class="font-bold text-slate-800">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <a href="/" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                <i class="fas fa-book mr-1"></i>Kitoblar
            </a>
            <a href="/statistika" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                <i class="fas fa-chart-bar mr-1"></i>Statistika
            </a>
            <%c++ if (loggedIn) { %>
            <a href="/kabinet" class="text-xs font-semibold text-blue-600 border border-blue-200 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                <i class="fas fa-user mr-1"></i><%c++ Libraries_tmp_stream << name; %>
            </a>
            <%c++ } else { %>
            <a href="/kirish" class="text-xs font-semibold bg-blue-600 text-white px-4 py-1.5 rounded-lg hover:bg-blue-700 transition">
                Kirish
            </a>
            <%c++ } %>
        </div>
    </div>
</nav>

<main class="max-w-6xl mx-auto px-4 py-8 flex-grow w-full">
    <div class="mb-8">
        <h1 class="text-2xl font-bold text-slate-800 mb-1">
            <i class="fas fa-map-marker-alt text-blue-600 mr-2"></i>Kutubxonalar
        </h1>
        <p class="text-sm text-slate-400">Jami <strong class="text-slate-600"><%c++ Libraries_tmp_stream << libraries.size(); %></strong> ta kutubxona mavjud</p>
    </div>

    <!-- Xarita -->
    <div class="bg-white rounded-2xl shadow-sm border border-slate-100 p-4 mb-8">
        <h2 class="text-sm font-bold text-slate-700 mb-3"><i class="fas fa-map text-blue-500 mr-1.5"></i>Xaritada ko'rish</h2>
        <div id="map"></div>
    </div>

    <!-- Kutubxonalar ro'yxati -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <%c++ for (size_t i = 0; i < libraries.size(); i++) {
        const auto& lib = libraries[i];
        std::string lat  = getOr(lib, "latitude",  "0");
        std::string lon  = getOr(lib, "longitude", "0");
        std::string libName = getOr(lib, "name");
        std::string bookCnt = getOr(lib, "book_count", "0");
    %>
        <div class="lib-card bg-white rounded-2xl shadow-sm border border-slate-100 p-5">
            <div class="flex items-start gap-3 mb-3" onclick="flyTo(<%c++ Libraries_tmp_stream << lat; %>, <%c++ Libraries_tmp_stream << lon; %>, '<%c++ Libraries_tmp_stream << libName; %>', <%c++ Libraries_tmp_stream << getOr(lib, "id", "0"); %>)" style="cursor:pointer">
                <div class="w-10 h-10 rounded-xl bg-blue-50 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-building-columns text-blue-600"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="font-bold text-slate-800 text-sm leading-tight"><%c++ Libraries_tmp_stream << libName; %></h3>
                    <p class="text-xs text-slate-400 mt-0.5">
                        <i class="fas fa-map-pin mr-1"></i>
                        <%c++ Libraries_tmp_stream << lat; %>, <%c++ Libraries_tmp_stream << lon; %>
                    </p>
                </div>
            </div>
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <div class="flex items-center gap-1 text-xs text-slate-500">
                        <i class="fas fa-book text-blue-400"></i>
                        <span id="bookCount_<%c++ Libraries_tmp_stream << getOr(lib, "id"); %>">
                            <%c++ Libraries_tmp_stream << bookCnt; %> ta kitob
                        </span>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-xs text-slate-400" id="distBtn_<%c++ Libraries_tmp_stream << i; %>">
                        <i class="fas fa-location-arrow mr-1 text-blue-400"></i><span id="dist_<%c++ Libraries_tmp_stream << i; %>">—</span>
                    </span>
                    <a href="/kutubxona/<%c++ Libraries_tmp_stream << getOr(lib, "id"); %>"
                       class="text-xs font-semibold bg-blue-600 text-white px-3 py-1.5 rounded-lg hover:bg-blue-700 transition">
                        Batafsil →
                    </a>
                </div>
            </div>
        </div>
    <%c++ } %>
    </div>
</main>

<footer class="py-5 text-center text-xs text-slate-300 border-t border-slate-100 mt-auto">
    © 2026 TATU Kutubxona •
    <a href="/haqida" class="hover:text-slate-500">Loyiha haqida</a>
</footer>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const libData = [
<%c++ for (size_t i = 0; i < libraries.size(); i++) {
    const auto& lib = libraries[i];
%>
    { name: "<%c++ Libraries_tmp_stream << getOr(lib, "name"); %>",
      lat: <%c++ Libraries_tmp_stream << (getOr(lib, "latitude", "0").empty() ? "0" : getOr(lib, "latitude", "0")); %>,
      lon: <%c++ Libraries_tmp_stream << (getOr(lib, "longitude", "0").empty() ? "0" : getOr(lib, "longitude", "0")); %>,
      id: <%c++ Libraries_tmp_stream << getOr(lib, "id", "0"); %>
    }<%c++ if (i + 1 < libraries.size()) Libraries_tmp_stream << ","; %>
<%c++ } %>
];

const map = L.map('map').setView([41.2995, 69.2401], 12);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
}).addTo(map);

const markers = {};
libData.forEach((lib, i) => {
    if (lib.lat === 0 && lib.lon === 0) return;
    const m = L.marker([lib.lat, lib.lon]).addTo(map)
        .bindPopup(`<b>${lib.name}</b><br><a href="/kutubxona/${lib.id}" style="color:#2563eb;font-size:12px;font-weight:600;">Batafsil →</a>`);
    markers[i] = m;
});

function flyTo(lat, lon, name) {
    if (lat === 0 && lon === 0) return;
    map.flyTo([lat, lon], 15, { duration: 1.2 });
    Object.values(markers).forEach(m => {
        if (m.getLatLng().lat === lat && m.getLatLng().lng === lon)
            m.openPopup();
    });
}

// Geolokatsiya — masofani hisoblash
if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(pos => {
        const userLat = pos.coords.latitude;
        const userLon = pos.coords.longitude;
        L.circleMarker([userLat, userLon], {
            radius: 8, fillColor: '#2563eb', color: '#fff',
            weight: 2, opacity: 1, fillOpacity: 0.9
        }).addTo(map).bindPopup('Siz shu yerdasiz');

        libData.forEach((lib, i) => {
            if (lib.lat === 0 && lib.lon === 0) return;
            const d = calcDist(userLat, userLon, lib.lat, lib.lon);
            const el = document.getElementById('dist_' + i);
            if (el) el.textContent = d < 1 ? Math.round(d * 1000) + ' m' : d.toFixed(1) + ' km';
        });
    }, () => {}, { timeout: 5000 });
}

function calcDist(lat1, lon1, lat2, lon2) {
    const R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLon = (lon2-lon1)*Math.PI/180;
    const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}
</script>
</body>
</html>
