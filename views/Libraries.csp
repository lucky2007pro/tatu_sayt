<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <%c++ Libraries_tmp_stream << PREMIUM_HEAD; %>
    <title>TATU Kutubxona | Kutubxonalar</title>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"/>
    <style>#map { height: 380px; z-index: 0; }</style>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto& libraries = @@.get<RowList>("libraries");
    auto  loggedIn  = @@.get<bool>("is_logged_in");
    auto& name      = @@.get<std::string>("reader_name");
%>

<!-- NAVBAR -->
<nav class="navbar-premium sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
            <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center text-white font-black text-sm shadow-md">T</div>
            <span class="font-extrabold text-slate-800 tracking-tight">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <a href="/" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-2 rounded-lg hover:bg-blue-50/60 transition"><i class="fas fa-book mr-1"></i>Kitoblar</a>
            <a href="/statistika" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-2 rounded-lg hover:bg-blue-50/60 transition"><i class="fas fa-chart-bar mr-1"></i>Statistika</a>
            <%c++ if (loggedIn) { %>
            <a href="/kabinet" class="text-xs font-semibold text-blue-600 border border-blue-200 px-3 py-2 rounded-lg hover:bg-blue-50/60 transition"><i class="fas fa-user mr-1"></i><%c++ Libraries_tmp_stream << name; %></a>
            <%c++ } else { %>
            <a href="/kirish" class="btn-prem btn-prem-primary text-xs py-2 px-4">Kirish</a>
            <%c++ } %>
        </div>
    </div>
</nav>

<main class="max-w-6xl mx-auto px-4 py-8 flex-grow w-full page-transition">
    <div class="mb-8 fade-in-up">
        <div class="section-heading-premium text-2xl">
            <span class="icon-wrap"><i class="fas fa-map-marker-alt text-sm"></i></span>
            Kutubxonalar
        </div>
        <p class="text-sm text-slate-400 mt-1 ml-12">Jami <strong class="text-slate-600"><%c++ Libraries_tmp_stream << libraries.size(); %></strong> ta kutubxona mavjud</p>
    </div>

    <!-- Xarita -->
    <div class="card-premium p-4 mb-8 fade-in-up">
        <h2 class="text-sm font-bold text-slate-700 mb-3 flex items-center gap-2"><i class="fas fa-map text-blue-500"></i>Xaritada ko'rish</h2>
        <div class="map-premium"><div id="map"></div></div>
    </div>

    <!-- Kutubxonalar ro'yxati -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <%c++ for (size_t i = 0; i < libraries.size(); i++) {
        const auto& lib = libraries[i];
        std::string lat  = getOr(lib, "latitude",  "0");
        std::string lon  = getOr(lib, "longitude", "0");
        std::string libName = getOr(lib, "name");
        std::string bookCnt = getOr(lib, "book_count", "0");
    %>
        <div class="card-premium p-5 fade-in-up">
            <div class="flex items-start gap-3 mb-3 cursor-pointer" onclick="flyTo(<%c++ Libraries_tmp_stream << lat; %>, <%c++ Libraries_tmp_stream << lon; %>, '<%c++ Libraries_tmp_stream << libName; %>', <%c++ Libraries_tmp_stream << getOr(lib, "id", "0"); %>)">
                <div class="w-11 h-11 rounded-xl bg-gradient-to-br from-blue-500 to-blue-600 flex items-center justify-center flex-shrink-0 shadow-md shadow-blue-500/20">
                    <i class="fas fa-building-columns text-white"></i>
                </div>
                <div class="flex-1 min-w-0">
                    <h3 class="font-bold text-slate-800 text-sm leading-tight"><%c++ Libraries_tmp_stream << libName; %></h3>
                    <p class="text-xs text-slate-400 mt-0.5"><i class="fas fa-map-pin mr-1"></i><%c++ Libraries_tmp_stream << lat; %>, <%c++ Libraries_tmp_stream << lon; %></p>
                </div>
            </div>
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <span class="pill-premium pill-blue"><i class="fas fa-book mr-1"></i><span id="bookCount_<%c++ Libraries_tmp_stream << getOr(lib, "id"); %>"><%c++ Libraries_tmp_stream << bookCnt; %></span> kitob</span>
                    <span class="text-xs text-slate-400" id="distBtn_<%c++ Libraries_tmp_stream << i; %>">
                        <i class="fas fa-location-arrow mr-1 text-blue-400"></i><span id="dist_<%c++ Libraries_tmp_stream << i; %>">—</span>
                    </span>
                </div>
                <a href="/kutubxona/<%c++ Libraries_tmp_stream << getOr(lib, "id"); %>" class="btn-prem btn-prem-primary text-xs py-1.5 px-3">Batafsil →</a>
            </div>
        </div>
    <%c++ } %>
    </div>
</main>

<footer class="footer-premium py-6 px-4 text-center text-xs mt-auto">
    <p>© 2026 TATU Kutubxona • <a href="/haqida" class="hover:text-white transition">Loyiha haqida</a></p>
</footer>

<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
const libData = [
<%c++ for (size_t i = 0; i < libraries.size(); i++) {
    const auto& lib = libraries[i];
%>
    { name: "<%c++ Libraries_tmp_stream << getOr(lib, "name"); %>",
      lat: <%c++ Libraries_tmp_stream << (getOr(lib, "latitude", "0").empty() ? "0" : getOr(lib, "latitude", "0")); %>,
      lon: <%c++ Libraries_tmp_stream << (getOr(lib, "longitude", "0").empty() ? "0" : getOr(lib, "longitude", "0")); %>,
      id: <%c++ Libraries_tmp_stream << getOr(lib, "id", "0"); %>
    }<%c++ if (i + 1 < libraries.size()) Libraries_tmp_stream << ","; %>
<%c++ } %>
];

const map = L.map('map').setView([41.2995, 69.2401], 12);
L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
    attribution: '© OpenStreetMap contributors'
}).addTo(map);

const markers = {};
libData.forEach((lib, i) => {
    if (lib.lat === 0 && lib.lon === 0) return;
    const icon = L.divIcon({
        className: '',
        html: '<div style="background:linear-gradient(135deg,#2563eb,#3b82f6);color:#fff;width:32px;height:32px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(37,99,235,.35);border:2px solid #fff"><i class="fas fa-building" style="transform:rotate(45deg);font-size:12px"></i></div>',
        iconSize: [32, 32], iconAnchor: [16, 32]
    });
    const m = L.marker([lib.lat, lib.lon], {icon}).addTo(map)
        .bindPopup(`<b>${lib.name}</b><br><a href="/kutubxona/${lib.id}" style="color:#2563eb;font-size:12px;font-weight:600;">Batafsil →</a>`);
    markers[i] = m;
});

function flyTo(lat, lon, name) {
    if (lat === 0 && lon === 0) return;
    map.flyTo([lat, lon], 15, { duration: 1.2 });
    Object.values(markers).forEach(m => {
        if (m.getLatLng().lat === lat && m.getLatLng().lng === lon) m.openPopup();
    });
}

if (navigator.geolocation) {
    navigator.geolocation.getCurrentPosition(pos => {
        const userLat = pos.coords.latitude, userLon = pos.coords.longitude;
        L.circleMarker([userLat, userLon], {
            radius: 8, fillColor: '#2563eb', color: '#fff', weight: 3, opacity: 1, fillOpacity: 0.9
        }).addTo(map).bindPopup('Siz shu yerdasiz');
        libData.forEach((lib, i) => {
            if (lib.lat === 0 && lib.lon === 0) return;
            const d = calcDist(userLat, userLon, lib.lat, lib.lon);
            const el = document.getElementById('dist_' + i);
            if (el) el.textContent = d < 1 ? Math.round(d * 1000) + ' m' : d.toFixed(1) + ' km';
        });
    }, () => {}, { timeout: 5000 });
}

function calcDist(lat1, lon1, lat2, lon2) {
    const R = 6371, dLat = (lat2-lat1)*Math.PI/180, dLon = (lon2-lon1)*Math.PI/180;
    const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180)*Math.cos(lat2*Math.PI/180)*Math.sin(dLon/2)**2;
    return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
}
</script>
</body>
</html>
