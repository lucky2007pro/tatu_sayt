<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TATU Kutubxona | Sevimlilar</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"/>
    <style> body { font-family: 'Inter', sans-serif; background: #f1f5f9; } </style>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    auto loggedIn = @@.get<bool>("is_logged_in");
    auto approved = @@.get<bool>("reader_approved");
    auto& name    = @@.get<std::string>("reader_name");
%>

<nav class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
    <div class="max-w-6xl mx-auto px-4 h-14 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2">
            <div class="w-7 h-7 bg-blue-600 rounded-lg flex items-center justify-center text-white font-black text-xs">T</div>
            <span class="font-bold text-slate-800">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <a href="/" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                <i class="fas fa-book mr-1"></i>Kitoblar
            </a>
            <a href="/sevimlilar" class="text-xs font-semibold text-red-600 border border-red-200 px-3 py-1.5 rounded-lg bg-red-50">
                <i class="fas fa-heart mr-1"></i>Sevimlilar
            </a>
            <%c++ if (loggedIn) { %>
            <a href="/kabinet" class="text-xs font-semibold text-blue-600 border border-blue-200 px-3 py-1.5 rounded-lg hover:bg-blue-50 transition">
                <i class="fas fa-user mr-1"></i><%c++ Favourites_tmp_stream << name; %>
            </a>
            <%c++ } else { %>
            <a href="/kirish" class="text-xs font-semibold bg-blue-600 text-white px-4 py-1.5 rounded-lg hover:bg-blue-700 transition">Kirish</a>
            <%c++ } %>
        </div>
    </div>
</nav>

<main class="max-w-6xl mx-auto px-4 py-8 flex-grow w-full">
    <div class="flex items-center justify-between mb-6">
        <h1 class="text-xl font-bold text-slate-800 flex items-center gap-2">
            <i class="fas fa-heart text-red-500"></i> Sevimli kitoblar
        </h1>
        <button onclick="clearAll()"
                class="text-xs text-slate-400 hover:text-red-500 transition flex items-center gap-1">
            <i class="fas fa-trash-alt"></i> Hammasini tozalash
        </button>
    </div>

    <!-- Kitoblar grid — JS tomonidan render qilinadi -->
    <div id="fav-grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"></div>

    <div id="fav-empty" class="hidden py-20 text-center">
        <div class="w-20 h-20 rounded-full bg-red-50 flex items-center justify-center mx-auto mb-4">
            <i class="fas fa-heart-broken text-red-300 text-3xl"></i>
        </div>
        <p class="text-slate-500 font-medium">Sevimli kitoblar yo'q</p>
        <p class="text-xs text-slate-400 mt-1">Kitob sahifasidagi <i class="fas fa-heart text-red-400"></i> tugmasini bosing</p>
        <a href="/" class="inline-block mt-4 text-xs font-bold text-blue-600 hover:underline">Kitoblarni ko'rish →</a>
    </div>
</main>

<footer class="py-5 text-center text-xs text-slate-300 border-t border-slate-100 mt-auto">
    © 2026 TATU Kutubxona
</footer>

<script>
const LS_KEY = 'tatu_favourites';

function getFavs() {
    try { return JSON.parse(localStorage.getItem(LS_KEY) || '[]'); } catch { return []; }
}

function clearAll() {
    if (!confirm("Barcha sevimlilarni o'chirmoqchimisiz?")) return;
    localStorage.removeItem(LS_KEY);
    render();
}

function removeFav(id) {
    const favs = getFavs().filter(f => String(f.id) !== String(id));
    localStorage.setItem(LS_KEY, JSON.stringify(favs));
    render();
}

function render() {
    const favs = getFavs();
    const grid  = document.getElementById('fav-grid');
    const empty = document.getElementById('fav-empty');

    if (favs.length === 0) {
        grid.innerHTML = '';
        empty.classList.remove('hidden');
        return;
    }
    empty.classList.add('hidden');
    grid.innerHTML = favs.map(b => `
        <div class="bg-white rounded-xl border border-slate-200 overflow-hidden shadow-sm hover:shadow-md transition hover:-translate-y-1 relative group">
            <button onclick="removeFav('${b.id}')"
                    class="absolute top-2 right-2 z-10 w-7 h-7 bg-white/90 rounded-full text-red-500 text-xs shadow hover:bg-red-50 hidden group-hover:flex items-center justify-center">
                <i class="fas fa-times"></i>
            </button>
            <a href="/kitob/${b.id}">
                <div class="h-40 bg-slate-100 flex items-center justify-center">
                    ${b.cover
                        ? `<img src="${b.cover}" class="w-full h-full object-cover" alt="">`
                        : `<i class="fas fa-book text-slate-300 text-4xl"></i>`}
                </div>
                <div class="p-3">
                    <p class="font-semibold text-xs text-slate-800 line-clamp-2 leading-snug">${b.title}</p>
                    <p class="text-[10px] text-slate-400 mt-0.5 truncate">${b.author || ''}</p>
                    <p class="text-[10px] mt-1 font-semibold ${b.avail ? 'text-green-600' : 'text-yellow-600'}">
                        ${b.avail ? '✅ Mavjud' : '🔒 Band'}
                    </p>
                </div>
            </a>
        </div>
    `).join('');
}

render();
</script>
</body>
</html>
