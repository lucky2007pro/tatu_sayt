<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <%c++ Favourites_tmp_stream << PREMIUM_HEAD; %>
    <title>TATU Kutubxona | Sevimlilar</title>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    using Row = std::map<std::string, std::string>;
    using RowList = std::vector<Row>;
    auto  loggedIn   = @@.get<bool>("is_logged_in");
    auto& name       = @@.get<std::string>("reader_name");
    auto& favourites = @@.get<RowList>("favourites");
    auto& csrf       = @@.get<std::string>("csrf_token");
    auto& flashMsg   = @@.get<std::string>("flash_msg");
    auto& flashType  = @@.get<std::string>("flash_type");
%>

<!-- NAVBAR -->
<nav class="navbar-premium sticky top-0 z-50">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
            <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center text-white font-black text-sm shadow-md">T</div>
            <span class="font-extrabold text-slate-800 tracking-tight">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <a href="/" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-2 rounded-lg hover:bg-blue-50/60 transition">
                <i class="fas fa-book mr-1"></i>Kitoblar
            </a>
            <a href="/sevimlilar" class="text-xs font-semibold text-rose-600 border border-rose-200 px-3 py-2 rounded-lg bg-rose-50/60">
                <i class="fas fa-heart mr-1"></i>Sevimlilar
            </a>
            <%c++ if (loggedIn) { %>
            <a href="/kabinet" class="text-xs font-semibold text-blue-600 border border-blue-200 px-3 py-2 rounded-lg hover:bg-blue-50/60 transition">
                <i class="fas fa-user mr-1"></i><%c++ Favourites_tmp_stream << name; %>
            </a>
            <%c++ } else { %>
            <a href="/kirish" class="btn-prem btn-prem-primary text-xs py-2 px-4">Kirish</a>
            <%c++ } %>
        </div>
    </div>
</nav>

<!-- Flash -->
<%c++ if (!flashMsg.empty()) { %>
<div class="max-w-6xl mx-auto px-4 pt-4">
    <div class="toast-premium <%c++ if (flashType == "success") { %>toast-success<%c++ } else { %>toast-error<%c++ } %>">
        <i class="fas <%c++ if (flashType == "success") { %>fa-check-circle<%c++ } else { %>fa-exclamation-circle<%c++ } %>"></i>
        <%c++ Favourites_tmp_stream << flashMsg; %>
    </div>
</div>
<%c++ } %>

<main class="max-w-6xl mx-auto px-4 py-8 flex-grow w-full page-transition">
    <div class="flex items-center justify-between mb-6 fade-in-up">
        <div>
            <div class="section-heading-premium text-xl">
                <span class="icon-wrap" style="background:linear-gradient(135deg,#f43f5e,#fb7185)"><i class="fas fa-heart text-sm"></i></span>
                Sevimli kitoblar
            </div>
            <p class="text-xs text-slate-400 mt-1 ml-12">Jami <strong class="text-slate-600"><%c++ Favourites_tmp_stream << favourites.size(); %></strong> ta kitob saqlangan</p>
        </div>
    </div>

    <%c++ if (favourites.empty()) { %>
    <div class="py-20 text-center fade-in-up">
        <div class="w-20 h-20 rounded-2xl bg-gradient-to-br from-rose-50 to-pink-50 flex items-center justify-center mx-auto mb-4 shadow-sm border border-rose-100">
            <i class="fas fa-heart-crack text-rose-300 text-3xl"></i>
        </div>
        <p class="text-slate-500 font-semibold">Sevimli kitoblar yo'q</p>
        <p class="text-xs text-slate-400 mt-1">Kitob sahifasidagi <i class="fas fa-heart text-rose-400"></i> tugmasini bosing</p>
        <a href="/" class="btn-prem btn-prem-primary mt-5 text-xs py-2.5 px-5">
            <i class="fas fa-search"></i> Kitoblarni ko'rish
        </a>
    </div>
    <%c++ } else { %>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        <%c++ for (auto& f : favourites) {
            auto bid     = getOr(f, "book");
            auto btitle  = getOr(f, "book_title", "Kitob");
            auto bcover  = getOr(f, "book_cover");
            auto bauthor = getOr(f, "author_name");
            auto bstat   = getOr(f, "availability_status", "available");
            auto brating = getOr(f, "average_rating");
            bool isAvail = (bstat == "available");
            bool isIssued = (bstat == "issued");
        %>
        <div class="book-card-premium relative group fade-in-up">
            <form method="POST" action="/sevimli/<%c++ Favourites_tmp_stream << bid; %>/ochir"
                  onsubmit="return confirm('Sevimlilardan olib tashlaymizmi?')"
                  class="absolute top-2 right-2 z-10 hidden group-hover:block">
                <input type="hidden" name="csrf_token" value="<%c++ Favourites_tmp_stream << csrf; %>">
                <button type="submit"
                        class="w-8 h-8 bg-white/90 backdrop-blur rounded-full text-rose-500 text-xs shadow-md hover:bg-rose-50 flex items-center justify-center transition">
                    <i class="fas fa-times"></i>
                </button>
            </form>
            <a href="/kitob/<%c++ Favourites_tmp_stream << bid; %>">
                <div class="h-44 bg-gradient-to-br from-slate-100 to-slate-200 flex items-center justify-center relative book-cover-shimmer">
                    <%c++ if (!bcover.empty()) { %>
                    <img src="<%c++ Favourites_tmp_stream << bcover; %>" class="w-full h-full object-cover" alt="">
                    <%c++ } else { %>
                    <i class="fas fa-book text-slate-300 text-4xl"></i>
                    <%c++ } %>
                    <span class="absolute bottom-2 left-2 pill-premium <%c++ if (isAvail) { %>pill-emerald<%c++ } else if (isIssued) { %>pill-amber<%c++ } else { %>pill-rose<%c++ } %>">
                        <%c++ if (isAvail) { %>✅ Mavjud<%c++ } else if (isIssued) { %>📤 Berilgan<%c++ } else { %>🔖 Bron<%c++ } %>
                    </span>
                </div>
                <div class="p-3">
                    <p class="font-semibold text-xs text-slate-800 line-clamp-2 leading-snug"><%c++ Favourites_tmp_stream << btitle; %></p>
                    <%c++ if (!bauthor.empty()) { %>
                    <p class="text-[10px] text-slate-400 mt-0.5 truncate"><%c++ Favourites_tmp_stream << bauthor; %></p>
                    <%c++ } %>
                    <%c++ if (!brating.empty() && brating != "0" && brating != "0.0") { %>
                    <span class="inline-block mt-1.5 pill-premium pill-amber text-[9px]">★ <%c++ Favourites_tmp_stream << brating; %></span>
                    <%c++ } %>
                </div>
            </a>
        </div>
        <%c++ } %>
    </div>
    <%c++ } %>
</main>

<footer class="footer-premium py-6 px-4 text-center text-xs mt-auto">
    <p>© 2026 TATU Kutubxona — Online band qilish tizimi</p>
</footer>
</body>
</html>
