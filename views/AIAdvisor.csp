<%inc
#include "ViewHelper.h"
%>
<!DOCTYPE html>
<html lang="uz">
<head>
    <%c++ AIAdvisor_tmp_stream << PREMIUM_HEAD; %>
    <title>TATU Kutubxona | AI Maslahatchi</title>
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
    <style>
        .chat-bubble-ai p { margin: 0 0 0.5rem 0; line-height: 1.55; }
        .chat-bubble-ai p:last-child { margin-bottom: 0; }
        .chat-bubble-ai strong { color: #0f172a; font-weight: 700; }
        .chat-bubble-ai ul, .chat-bubble-ai ol { margin: 0.25rem 0 0.5rem 1.25rem; }
        .chat-bubble-ai li { margin-bottom: 0.25rem; }
    </style>
</head>
<body class="min-h-screen flex flex-col">
<%c++
    auto loggedIn   = @@.get<bool>("is_logged_in");
    auto& name      = @@.get<std::string>("reader_name");
    auto& csrf      = @@.get<std::string>("csrf_token");
%>

<!-- NAVBAR -->
<nav class="navbar-premium sticky top-0 z-50">
    <div class="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
        <a href="/" class="flex items-center gap-2.5">
            <div class="w-9 h-9 bg-gradient-to-br from-blue-600 to-blue-700 rounded-xl flex items-center justify-center text-white font-black text-sm shadow-md">T</div>
            <span class="font-extrabold text-slate-800 tracking-tight">TATU Kutubxona</span>
        </a>
        <div class="flex items-center gap-2">
            <a href="/" class="text-xs font-semibold text-slate-500 hover:text-blue-600 px-3 py-2 rounded-lg hover:bg-blue-50/60 transition"><i class="fas fa-book mr-1"></i>Kitoblar</a>
            <a href="/sevimlilar" class="text-xs font-semibold text-slate-500 hover:text-red-600 px-3 py-2 rounded-lg hover:bg-red-50/60 transition"><i class="fas fa-heart mr-1"></i>Sevimlilar</a>
            <%c++ if (loggedIn) { %>
            <a href="/kabinet" class="text-xs font-semibold text-blue-600 border border-blue-200 px-3 py-2 rounded-lg hover:bg-blue-50/60 transition"><i class="fas fa-user mr-1"></i><%c++ AIAdvisor_tmp_stream << name; %></a>
            <%c++ } else { %>
            <a href="/kirish" class="btn-prem btn-prem-primary text-xs py-2 px-4">Kirish</a>
            <%c++ } %>
        </div>
    </div>
</nav>

<main class="max-w-3xl w-full mx-auto px-4 py-6 flex-1 flex flex-col page-transition">
    <!-- Sarlavha -->
    <div class="text-center mb-6 fade-in-up">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-gradient-to-br from-purple-500 to-blue-500 text-white text-2xl mb-3 shadow-xl shadow-purple-500/25 float-anim">
            <i class="fas fa-robot"></i>
        </div>
        <h1 class="text-2xl font-extrabold text-slate-800">AI Maslahatchi</h1>
        <p class="text-sm text-slate-400 mt-1">Gemini asosida — kitob tanlashda yordam beradi</p>
    </div>

    <!-- AI warning -->
    <div id="ai-warning" class="hidden mb-4 toast-premium toast-error">
        <i class="fas fa-exclamation-triangle"></i>
        AI hozircha sozlanmagan. Administrator <code class="bg-red-100 px-1.5 py-0.5 rounded text-xs">GEMINI_API_KEY</code> ni o'rnatishi kerak.
    </div>

    <!-- Chat oynasi -->
    <div id="chat-window" class="flex-1 aurora-bg rounded-2xl p-4 overflow-y-auto border border-slate-200/60" style="min-height:50vh;max-height:65vh;background:var(--color-surface-2)">
        <div class="flex gap-3 mb-4 fade-in-up">
            <div class="w-9 h-9 rounded-full bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center text-white text-sm flex-shrink-0 shadow-md">
                <i class="fas fa-robot"></i>
            </div>
            <div class="chat-bubble-ai px-4 py-3 max-w-[85%]">
                <p>Salom! Men <strong>TATU Kutubxona AI maslahatchi</strong>man. Sizga kitob tanlashda yordam beraman. 🤖📚</p>
                <p class="text-xs text-slate-400 mt-2">Quyidagi savollarni ko'rib chiqing yoki o'zingiznikini yozing:</p>
            </div>
        </div>

        <div id="quick-prompts" class="grid grid-cols-1 md:grid-cols-2 gap-2 mb-2">
            <button class="quick-prompt text-left text-xs bg-white border border-slate-200 px-4 py-2.5 rounded-xl hover:border-purple-400 hover:bg-purple-50/50 transition hover-lift">
                💡 Boshlovchilar uchun yaxshi kitoblar bormi?
            </button>
            <button class="quick-prompt text-left text-xs bg-white border border-slate-200 px-4 py-2.5 rounded-xl hover:border-purple-400 hover:bg-purple-50/50 transition hover-lift">
                🚀 Texnologiya/IT haqida nima tavsiya qilasiz?
            </button>
            <button class="quick-prompt text-left text-xs bg-white border border-slate-200 px-4 py-2.5 rounded-xl hover:border-purple-400 hover:bg-purple-50/50 transition hover-lift">
                📜 O'zbek mumtoz adabiyotidan kitob tavsiya qiling
            </button>
            <button class="quick-prompt text-left text-xs bg-white border border-slate-200 px-4 py-2.5 rounded-xl hover:border-purple-400 hover:bg-purple-50/50 transition hover-lift">
                🧠 Psixologiya bo'yicha qiziqarli kitob bormi?
            </button>
        </div>
    </div>

    <!-- Yozish formasi -->
    <form id="chat-form" class="mt-3 flex items-end gap-2">
        <input type="hidden" name="csrf_token" id="csrf_token" value="<%c++ AIAdvisor_tmp_stream << csrf; %>">
        <textarea id="chat-input" rows="1" maxlength="1500"
                  placeholder="Savolingizni yozing..."
                  class="input-premium flex-1 resize-none rounded-2xl px-4 py-3 text-sm shadow-sm"
                  style="min-height:44px;max-height:140px;"></textarea>
        <button type="submit" id="send-btn"
                class="btn-prem btn-prem-accent px-5 py-3 rounded-2xl text-sm shadow-md disabled:opacity-50 disabled:cursor-not-allowed">
            <i class="fas fa-paper-plane"></i>
        </button>
    </form>
    <p class="text-[11px] text-slate-400 text-center mt-2">AI ba'zan xato qilishi mumkin. Muhim qarorlarni o'zingiz tekshirib oling.</p>
</main>

<footer class="footer-premium py-5 text-center text-xs mt-auto">
    <p>© 2026 TATU Kutubxona — AI by Gemini</p>
</footer>

<script>
const CSRF_TOKEN = document.getElementById('csrf_token').value;
let conversationHistory = [];
const chatWindow = document.getElementById('chat-window');
const chatInput  = document.getElementById('chat-input');
const chatForm   = document.getElementById('chat-form');
const sendBtn    = document.getElementById('send-btn');
const warningBox = document.getElementById('ai-warning');
const quickPrompts = document.getElementById('quick-prompts');

function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function appendUserMessage(text) {
    const el = document.createElement('div');
    el.className = 'flex gap-3 mb-4 justify-end fade-in-up';
    el.innerHTML = `<div class="chat-bubble-user px-4 py-3 max-w-[85%]"><p class="text-sm whitespace-pre-wrap">${escapeHtml(text)}</p></div>
        <div class="w-9 h-9 rounded-full bg-slate-200 flex items-center justify-center text-slate-600 text-sm flex-shrink-0"><i class="fas fa-user"></i></div>`;
    chatWindow.appendChild(el);
    chatWindow.scrollTop = chatWindow.scrollHeight;
}

function appendAIMessage(markdownText) {
    const el = document.createElement('div');
    el.className = 'flex gap-3 mb-4 fade-in-up';
    const html = (window.marked ? marked.parse(markdownText) : `<p>${escapeHtml(markdownText)}</p>`);
    el.innerHTML = `<div class="w-9 h-9 rounded-full bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center text-white text-sm flex-shrink-0 shadow-md"><i class="fas fa-robot"></i></div>
        <div class="chat-bubble-ai px-4 py-3 max-w-[85%] text-sm">${html}</div>`;
    chatWindow.appendChild(el);
    chatWindow.scrollTop = chatWindow.scrollHeight;
}

function appendError(text) {
    const el = document.createElement('div');
    el.className = 'flex gap-3 mb-4 fade-in-up';
    el.innerHTML = `<div class="w-9 h-9 rounded-full bg-red-100 flex items-center justify-center text-red-500 text-sm flex-shrink-0"><i class="fas fa-exclamation"></i></div>
        <div class="px-4 py-3 max-w-[85%] text-sm bg-red-50 border border-red-200 text-red-700 rounded-2xl">${escapeHtml(text)}</div>`;
    chatWindow.appendChild(el);
    chatWindow.scrollTop = chatWindow.scrollHeight;
}

function showTyping() {
    const el = document.createElement('div');
    el.id = 'typing-indicator';
    el.className = 'flex gap-3 mb-4';
    el.innerHTML = `<div class="w-9 h-9 rounded-full bg-gradient-to-br from-purple-500 to-blue-500 flex items-center justify-center text-white text-sm flex-shrink-0 shadow-md"><i class="fas fa-robot"></i></div>
        <div class="chat-bubble-ai px-5 py-3 flex items-center gap-1.5"><span class="typing-dot"></span><span class="typing-dot"></span><span class="typing-dot"></span></div>`;
    chatWindow.appendChild(el);
    chatWindow.scrollTop = chatWindow.scrollHeight;
}

function hideTyping() { const t = document.getElementById('typing-indicator'); if (t) t.remove(); }

async function sendMessage(text) {
    if (!text.trim()) return;
    appendUserMessage(text);
    if (quickPrompts) quickPrompts.classList.add('hidden');
    chatInput.value = '';
    chatInput.style.height = 'auto';
    sendBtn.disabled = true;
    showTyping();
    try {
        const r = await fetch('/api/ai-chat', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, credentials: 'same-origin',
            body: JSON.stringify({ message: text, history: conversationHistory.slice(-8), csrf_token: CSRF_TOKEN })
        });
        hideTyping();
        const data = await r.json();
        if (!r.ok || data.error) { appendError(data.error || `Xato: HTTP ${r.status}`); }
        else {
            const reply = data.reply || '';
            appendAIMessage(reply);
            conversationHistory.push({ role: 'user', content: text });
            conversationHistory.push({ role: 'model', content: reply });
        }
    } catch (e) { hideTyping(); appendError("Tarmoq xatosi: " + (e.message || e)); }
    finally { sendBtn.disabled = false; chatInput.focus(); }
}

chatForm.addEventListener('submit', e => { e.preventDefault(); sendMessage(chatInput.value); });
chatInput.addEventListener('keydown', e => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(chatInput.value); } });
chatInput.addEventListener('input', () => { chatInput.style.height = 'auto'; chatInput.style.height = Math.min(chatInput.scrollHeight, 140) + 'px'; });
document.querySelectorAll('.quick-prompt').forEach(btn => {
    btn.addEventListener('click', () => sendMessage(btn.textContent.trim().replace(/^[^\w\u0400-\u04FF\u0500-\u052F]+\s*/, '')));
});
fetch('/api/ai-status').then(r => r.json()).then(d => {
    if (d && d.configured === false) { warningBox.classList.remove('hidden'); sendBtn.disabled = true; chatInput.disabled = true; chatInput.placeholder = 'AI sozlanmagan...'; }
}).catch(() => {});
chatInput.focus();
</script>
</body>
</html>
